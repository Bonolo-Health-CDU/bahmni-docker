<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="cdu_login_logo" inherit_id="web.login_layout">
            <xpath expr="//img[contains(@t-attf-src, 'company_logo')]" position="replace">
                <div style="text-align: center;">
                    <img src="/cdu_base/static/src/img/logo.png" style="max-height:120px; max-width:100%; width:auto;"/>
                    <h3 style="margin-top: 12px; margin-bottom: 18px; text-align: center; font-weight: 600;">
                        Central Dispensing Unit
                    </h3>
                </div>
            </xpath>
        </template>

        <template id="cdu_login_button_style" inherit_id="web.login">
            <xpath expr="//t[@t-call='web.login_layout']" position="inside">
                <t>
                    <style>
                        .oe_login_form .btn-primary {
                            background-color: #005baa !important;
                            border-color: #005baa !important;
                        }
                    </style>
                </t>
            </xpath>
        </template>
    </data>
</odoo>
