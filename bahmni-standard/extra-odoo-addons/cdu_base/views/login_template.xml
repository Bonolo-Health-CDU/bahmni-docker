<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="cdu_login_logo" inherit_id="web.login_layout">
            <xpath expr="//div[hasclass('container') and hasclass('py-5')]" position="attributes">
                <attribute name="class">container py-5 cdu-login-shell</attribute>
            </xpath>
            <xpath expr="//div[contains(@t-attf-class, 'o_database_list')]" position="attributes">
                <attribute name="t-attf-class">card border-0 mx-auto bg-100 {{login_card_classes}} o_database_list cdu-login-card</attribute>
            </xpath>
            <xpath expr="//div[hasclass('card-body')]" position="attributes">
                <attribute name="class">card-body cdu-login-card-body</attribute>
            </xpath>
            <xpath expr="//div[contains(@t-attf-class, 'text-center') and contains(@t-attf-class, 'border-bottom')]" position="replace">
                <div class="cdu-login-brand">
                    <div class="cdu-login-emblem">
                        <img src="/cdu_base/static/src/img/logo.png" alt="Central Dispensing Unit"/>
                    </div>
                    <p class="cdu-login-eyebrow">Ministry of Health</p>
                    <h1>Central Dispensing Unit</h1>
                    <p class="cdu-login-subtitle">
                        Supporting decentralized drug distribution through coordinated prescription processing,
                        stock management, dispensing, and collection-point fulfilment.
                    </p>
                </div>
            </xpath>
            <xpath expr="//div[hasclass('text-center') and hasclass('border-top')]" position="replace"/>
        </template>
    </data>
</odoo>
