<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cdu_report_wizard_form" model="ir.ui.view">
        <field name="name">cdu.report.wizard.form</field>
        <field name="model">cdu.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Report">
                <sheet>
                    <group>
                        <group string="Report">
                            <field name="report_type"/>
                            <label for="date_from" string="Reporting Period"/>
                            <div class="o_row">
                                <field name="date_from" class="oe_inline"/>
                                <span class="mx-2">to</span>
                                <field name="date_to" class="oe_inline"/>
                            </div>
                        </group>
                        <group string="Organisation">
                            <field name="district_name"/>
                            <field name="facility_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="programme"/>
                            <field name="pup_type"/>
                            <field name="collection_point_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Patient Filters" attrs="{'invisible': [('report_type', 'not in', ['enrolment', 'dispensing'])]}">
                        <field name="gender"/>
                        <field name="age_from"/>
                        <field name="age_to"/>
                    </group>
                    <group string="Workflow Status">
                        <field name="verification_status" attrs="{'invisible': [('report_type', '!=', 'verification')]}"/>
                        <field name="validation_status" attrs="{'invisible': [('report_type', '!=', 'validation')]}"/>
                        <field name="dispensing_status" attrs="{'invisible': [('report_type', '!=', 'dispensing')]}"/>
                        <field name="parcel_status" attrs="{'invisible': [('report_type', '!=', 'parcel_production')]}"/>
                    </group>
                    <field name="export_file" invisible="1"/>
                    <field name="export_filename" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_view_report" type="object" string="View Report" class="btn-primary"/>
                    <button name="action_export_xlsx" type="object" string="Export Excel" class="btn-secondary"/>
                    <button name="action_export_csv" type="object" string="Export CSV" class="btn-secondary"/>
                    <button name="action_export_pdf" type="object" string="PDF Summary" class="btn-secondary"/>
                    <button string="Close" special="cancel" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cdu_report_wizard" model="ir.actions.act_window">
        <field name="name">Generate Report</field>
        <field name="res_model">cdu.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

