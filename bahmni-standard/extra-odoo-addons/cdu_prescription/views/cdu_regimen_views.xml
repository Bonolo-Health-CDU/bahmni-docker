<odoo>

    <record id="view_cdu_regimen_tree" model="ir.ui.view">
        <field name="name">cdu.regimen.tree</field>
        <field name="model">cdu.regimen</field>

        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_cdu_regimen_form" model="ir.ui.view">
        <field name="name">cdu.regimen.form</field>
        <field name="model">cdu.regimen</field>

        <field name="arch" type="xml">
            <form>

                <sheet>

                    <group>

                        <field name="code"/>

                        <field name="name"/>

                        <field name="active"/>

                    </group>

                    <notebook>

                        <page string="Drug Components">

                            <field name="line_ids">

                                <tree editable="bottom">

                                    <field name="product_id"/>

                                    <field name="daily_dose"/>

                                </tree>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>

    <record id="action_cdu_regimen" model="ir.actions.act_window">
        <field name="name">Regimens</field>
        <field name="res_model">cdu.regimen</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>