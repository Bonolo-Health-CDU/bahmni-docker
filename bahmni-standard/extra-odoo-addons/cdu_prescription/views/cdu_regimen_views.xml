<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cdu_medicine_tree" model="ir.ui.view">
        <field name="name">cdu.medicine.tree</field>
        <field name="model">cdu.medicine</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_cdu_medicine_form" model="ir.ui.view">
        <field name="name">cdu.medicine.form</field>
        <field name="model">cdu.medicine</field>
        <field name="arch" type="xml">
            <form string="Medicine">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cdu_medicine" model="ir.actions.act_window">
        <field name="name">Medicines</field>
        <field name="res_model">cdu.medicine</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_cdu_regimen_option_tree" model="ir.ui.view">
        <field name="name">cdu.regimen.option.tree</field>
        <field name="model">cdu.regimen.option</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="regimen_id"/>
                <field name="is_default"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_cdu_regimen_option_form" model="ir.ui.view">
        <field name="name">cdu.regimen.option.form</field>
        <field name="model">cdu.regimen.option</field>
        <field name="arch" type="xml">
            <form string="Regimen Dispensing Option">
                <sheet>
                    <group>
                        <field name="regimen_id"/>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="is_default"/>
                        <field name="active"/>
                    </group>
                    <group string="Medicines">
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="medicine_id" options="{'no_create': True, 'no_open': True}"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cdu_regimen_tree" model="ir.ui.view">
        <field name="name">cdu.regimen.tree</field>
        <field name="model">cdu.regimen</field>
        <field name="arch" type="xml">
            <tree>
                <field name="eregister_name"/>
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_cdu_regimen_form" model="ir.ui.view">
        <field name="name">cdu.regimen.form</field>
        <field name="model">cdu.regimen</field>
        <field name="arch" type="xml">
            <form string="Regimen">
                <sheet>
                    <div class="oe_title">
                        <label for="eregister_name"/>
                        <h1><field name="eregister_name"/></h1>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <group string="Alternative Dispensing Options">
                        <field name="option_ids" context="{'default_regimen_id': active_id}">
                            <tree>
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="is_default"/>
                                <field name="active"/>
                            </tree>
                            <form string="Dispensing Option">
                                <group>
                                    <field name="name"/>
                                    <field name="sequence"/>
                                    <field name="is_default"/>
                                    <field name="active"/>
                                </group>
                                <field name="line_ids">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="medicine_id" options="{'no_create': True, 'no_open': True}"/>
                                    </tree>
                                </field>
                            </form>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cdu_regimen" model="ir.actions.act_window">
        <field name="name">Regimens</field>
        <field name="res_model">cdu.regimen</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
