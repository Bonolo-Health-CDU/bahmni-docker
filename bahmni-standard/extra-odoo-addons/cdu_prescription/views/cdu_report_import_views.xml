<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cdu_report_run_tree" model="ir.ui.view">
        <field name="name">cdu.report.run.tree</field>
        <field name="model">cdu.report.run</field>
        <field name="arch" type="xml">
            <tree decoration-danger="state == 'failed'" decoration-warning="state in ('completed_with_errors', 'duplicate')">
                <field name="name"/>
                <field name="ingestion_channel"/>
                <field name="source_file_name"/>
                <field name="source_facility_id"/>
                <field name="report_generated_at"/>
                <field name="ingested_at"/>
                <field name="total_rows"/>
                <field name="imported_rows"/>
                <field name="updated_rows"/>
                <field name="duplicate_rows"/>
                <field name="failed_rows"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_cdu_report_run_form" model="ir.ui.view">
        <field name="name">cdu.report.run.form</field>
        <field name="model">cdu.report.run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_import_file" string="Import Report" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,completed,completed_with_errors,failed,duplicate"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Source">
                            <field name="source_facility_id"/>
                            <field name="ingestion_channel"/>
                            <field name="source_file" filename="source_file_name"/>
                            <field name="source_file_name" invisible="1"/>
                            <field name="remote_file_id"/>
                            <field name="remote_file_etag"/>
                            <field name="remote_folder_name"/>
                            <field name="remote_folder_path"/>
                            <field name="poll_log_id" groups="base.group_system"/>
                            <field name="poll_triggered_at"/>
                            <field name="file_hash"/>
                        </group>
                        <group string="Report Metadata">
                            <field name="report_title"/>
                            <field name="report_period"/>
                            <field name="report_generated_at"/>
                            <field name="ingested_at"/>
                        </group>
                    </group>
                    <group string="Import Summary">
                        <field name="total_rows"/>
                        <field name="imported_rows"/>
                        <field name="updated_rows"/>
                        <field name="duplicate_rows"/>
                        <field name="failed_rows"/>
                    </group>
                    <notebook>
                        <page string="Rows">
                            <field name="row_ids">
                                <tree decoration-danger="status == 'failed'" decoration-muted="status == 'duplicate'">
                                    <field name="row_number"/>
                                    <field name="patient_name"/>
                                    <field name="eregister_id"/>
                                    <field name="prescription_date"/>
                                    <field name="regimen_prescribed"/>
                                    <field name="drug_pickup_point"/>
                                    <field name="patient_id"/>
                                    <field name="prescription_id"/>
                                    <field name="status"/>
                                    <field name="error_message"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Errors">
                            <field name="error_message"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_cdu_report_run" model="ir.actions.act_window">
        <field name="name">Report Imports</field>
        <field name="res_model">cdu.report.run</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
