<odoo>

    <record id="view_product_template_form_cdu" model="ir.ui.view">
        <field name="name">product.template.form.cdu</field>
        <field name="model">product.template</field>

        <field name="inherit_id" ref="product.product_template_only_form_view"/>

        <field name="arch" type="xml">

            <xpath expr="//sheet/notebook" position="inside">

                <page string="CDU">

                    <group>

                        <field name="cdu_is_drug"/>

                        <field name="cdu_catalog_source"/>

                        <field name="cdu_generic_name"/>

                        <field name="cdu_strength"/>

                        <field name="cdu_dosage_form"/>

                        <field name="cdu_verification_label" readonly="1"/>

                        <field name="cdu_drug_code"/>

                        <field name="cdu_pack_size"/>

                        <field name="cdu_default_daily_dose"/>

                    </group>

                </page>

            </xpath>

        </field>
    </record>

</odoo>
