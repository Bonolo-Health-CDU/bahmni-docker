<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cdu_prescription_tree" model="ir.ui.view">
        <field name="name">cdu.prescription.tree</field>
        <field name="model">cdu.prescription</field>
        <field name="arch" type="xml">
            <tree decoration-danger="state == 'validation_failed'" decoration-muted="state in ('cancelled', 'on_hold')">
                <field name="name"/>
                <field name="barcode"/>
                <field name="facility_name"/>
                <field name="patient_identifier"/>
                <field name="repeat_count"/>
                <field name="refill_date"/>
                <field name="collection_point_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_cdu_prescription_form" model="ir.ui.view">
        <field name="name">cdu.prescription.form</field>
        <field name="model">cdu.prescription</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Verify: Visible in 'awaiting_verification' OR if returning from 'rejected_to_call_center' -->
                    <button name="action_verify" string="Verify" type="object" class="btn-primary" 
                            attrs="{'invisible': [('state', 'not in', ['awaiting_verification', 'rejected_to_call_center'])]}"/>

                    <!-- Validate: Only visible during normal validation flow -->
                    <button name="action_validate_prescription" string="Validate" type="object" class="btn-primary" 
                            attrs="{'invisible': [('state', 'not in', ['awaiting_validation', 'validation_failed'])]}"/>

                    <!-- Reject to Call Center: Visible during Verification and Validation phases -->
                    <button name="action_reject_to_call_center" string="Reject to Call Center" type="object" class="btn-danger" 
                            attrs="{'invisible': [('state', 'not in', ['awaiting_verification', 'awaiting_validation'])]}"/>

                    <!-- Reject to Facility: Visible during Verification, Validation, or specifically in rejected_to_call_center -->
                    <button name="action_reject_to_facility" string="Reject to Facility" type="object" class="btn-danger" 
                            attrs="{'invisible': [('state', 'not in', ['awaiting_verification', 'awaiting_validation', 'rejected_to_call_center'])]}"/>

                    <!-- Statusbar: Only show the main flow states. 
                        Rejected states will ONLY appear when the record is actually in that state. -->
                    <field name="state" widget="statusbar" statusbar_visible="awaiting_verification,awaiting_validation,awaiting_batching"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Source">
                            <field name="barcode"/>
                            <field name="source_document_ref"/>
                            <field name="facility_id"/>
                            <field name="facility_name"/>
                            <field name="facility_code"/>
                            <field name="prescription_date"/>
                        </group>
                        <group string="Workflow">
                            <field name="repeat_count"/>
                            <field name="refill_date"/>
                            <field name="clinical_review_only"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Patient">
                            <group>
                                <group>
                                    <field name="patient_id"/>
                                    <field name="patient_identifier"/>
                                    <field name="patient_surname"/>
                                    <field name="patient_first_name"/>
                                </group>
                                <group>
                                    <field name="patient_date_of_birth"/>
                                    <field name="patient_language"/>
                                    <field name="patient_gender"/>
                                    <field name="patient_phone"/>
                                    <field name="patient_address"/>
                                </group>
                            </group>
                        </page>
                        <page string="Clinical">
                            <group>
                                <group string="Diagnosis">
                                    <field name="allergies"/>
                                    <field name="diagnosis_asthma_copd"/>
                                    <field name="diagnosis_diabetes_type_2"/>
                                    <field name="diagnosis_family_planning"/>
                                    <field name="diagnosis_hypertension"/>
                                    <field name="diagnosis_hiv"/>
                                    <field name="diagnosis_arthritis"/>
                                </group>
                                <group string="Date Taken">
                                    <field name="viral_load_date_taken"/>
                                    <field name="cd4_count_date_taken"/>
                                </group>
                            </group>
                        </page>
                        <page string="Collection">
                            <group>
                                <group>
                                    <field name="collection_point_id"/>
                                    <field name="new_patient"/>
                                    <field name="repeat_patient"/>
                                    <field name="next_clinical_visit_date"/>
                                </group>
                                <group string="Nominated Collector">
                                    <field name="nominated_person_name"/>
                                    <field name="nominated_person_id_number"/>
                                    <field name="nominated_person_relationship"/>
                                    <field name="nominated_person_phone"/>
                                </group>
                            </group>
                        </page>
                        <page string="Medicines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="medicine_text"/>
                                    <field name="directions"/>
                                    <field name="form"/>
                                    <field name="strength"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_id"/>
                                    <field name="refill_number"/>
                                    <field name="one_time_use_only"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Prescriber">
                            <group>
                                <field name="prescriber_name"/>
                                <field name="prescriber_contact"/>
                                <field name="prescriber_registration_number"/>
                            </group>
                        </page>
                        <page string="Validation">
                            <field name="validation_notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_cdu_prescription_search" model="ir.ui.view">
        <field name="name">cdu.prescription.search</field>
        <field name="model">cdu.prescription</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="barcode"/>
                <field name="patient_identifier"/>
                <field name="facility_name"/>
                <field name="collection_point_id"/>
                <filter string="Awaiting Validation" name="awaiting_validation" domain="[('state', '=', 'awaiting_validation')]"/>
                <filter string="Validation Failed" name="validation_failed" domain="[('state', '=', 'validation_failed')]"/>
                <filter string="Awaiting Batching" name="awaiting_batching" domain="[('state', '=', 'awaiting_batching')]"/>
                <group expand="0" string="Group By">
                    <filter string="Collection Point" name="group_collection_point" context="{'group_by': 'collection_point_id'}"/>
                    <filter string="Refill Date" name="group_refill_date" context="{'group_by': 'refill_date'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cdu_prescription" model="ir.actions.act_window">
        <field name="name">CDU Prescriptions</field>
        <field name="res_model">cdu.prescription</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_cdu_prescription_search"/>
    </record>
</odoo>
