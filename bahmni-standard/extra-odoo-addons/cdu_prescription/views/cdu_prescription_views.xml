<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cdu_prescription_tree" model="ir.ui.view">
        <field name="name">cdu.prescription.tree</field>
        <field name="model">cdu.prescription</field>
        <field name="arch" type="xml">
            <tree class="o_cdu_prescription_list"
                  default_order="next_drug_pickup_date asc, patient_first_name asc"
                  decoration-danger="state in ('rejected_to_call_center', 'rejected_to_facility')"
                  decoration-muted="state == 'cancelled'">
                <field name="name" string="Prescription ID" optional="hide"/>
                <field name="patient_first_name" optional="show"/>
                <field name="facility_name"/>
                <field name="patient_identifier"/>
                <field name="rejection_reason" string="Rejection Reasons" optional="show"/>
                <field name="prescription_date"/>
                <field name="next_drug_pickup_date"/>
                <field name="facility_days_supply" optional="show"/>
                <field name="cdu_days_supply"/>
                <field name="remaining_days_supply"/>
                <field name="regimen_prescribed_raw"/>
                <field name="collection_point_id"/>
                <field name="batch_id"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state in ('awaiting_verification', 'awaiting_validation', 'awaiting_batching', 'awaiting_picking', 'awaiting_dispensing', 'awaiting_bagging_qa', 'awaiting_boxing')"
                       decoration-warning="state == 'awaiting_dispatch'"
                       decoration-success="state == 'dispatched'"
                       decoration-danger="state in ('rejected_to_call_center', 'rejected_to_facility')"
                       decoration-muted="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_cdu_prescription_form" model="ir.ui.view">
        <field name="name">cdu.prescription.form</field>
        <field name="model">cdu.prescription</field>
        <field name="arch" type="xml">
            <form class="o_cdu_prescription_form">
                <header>
                    <button name="action_mark_patient_verified" string="Verify" type="object" class="oe_highlight" confirm="Are you sure you want to verify this prescription?" groups="cdu_prescription.group_cdu_data_clerk,cdu_prescription.group_cdu_admin" attrs="{'invisible': [('state', '!=', 'awaiting_verification')]}"/>
                    <button name="action_mark_medicine_validated" string="Validate" type="object" class="oe_highlight" confirm="Are you sure you want to validate this prescription?" groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin" attrs="{'invisible': [('state', '!=', 'awaiting_validation')]}"/>
                    <button name="action_reject_to_call_center" string="Reject to Call Center" type="object" class="btn-danger" groups="cdu_prescription.group_cdu_data_clerk" attrs="{'invisible': [('state', '!=', 'awaiting_verification')]}"/>
                    <button name="action_reject_to_call_center" string="Reject to Call Center" type="object" class="btn-danger" groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin" attrs="{'invisible': [('state', '!=', 'awaiting_validation')]}"/>
                    <button name="action_return_to_previous_stage"
                            string="Return to Previous Stage"
                            type="object"
                            class="oe_highlight"
                            confirm="Are you sure the rejected-prescription work is complete and you want to return it to its previous stage?"
                            groups="cdu_prescription.group_cdu_data_clerk,cdu_prescription.group_cdu_call_agent,cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"
                            attrs="{'invisible': [('state', 'not in', ('rejected_to_call_center', 'rejected_to_facility'))]}"/>
                    <button name="action_reject_to_facility" string="Reject to Facility" type="object" class="btn-danger" groups="cdu_prescription.group_cdu_data_clerk" attrs="{'invisible': [('state', '!=', 'awaiting_verification')]}"/>
                    <button name="action_reject_to_facility" string="Reject to Facility" type="object" class="btn-danger" groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin" attrs="{'invisible': [('state', '!=', 'awaiting_validation')]}"/>
                    <button name="action_remap_regimens" string="Remap Regimen" type="object" class="btn-secondary" groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" groups="cdu_prescription.group_cdu_admin" attrs="{'invisible': [('state', '=', 'cancelled')]}"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="awaiting_verification,awaiting_validation,awaiting_batching"
                           attrs="{'invisible': [('state', 'not in', ('awaiting_verification', 'awaiting_validation', 'awaiting_batching'))]}"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="cancelled"
                           attrs="{'invisible': [('state', '!=', 'cancelled')]}"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="rejected_to_call_center"
                           attrs="{'invisible': [('state', '!=', 'rejected_to_call_center')]}"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="rejected_to_facility"
                           attrs="{'invisible': [('state', '!=', 'rejected_to_facility')]}"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="awaiting_batching,awaiting_picking,awaiting_dispensing"
                           attrs="{'invisible': [('state', 'not in', ('awaiting_picking', 'awaiting_dispensing'))]}"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="awaiting_dispensing,awaiting_bagging_qa"
                           attrs="{'invisible': [('state', '!=', 'awaiting_bagging_qa')]}"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="awaiting_bagging_qa,awaiting_boxing,awaiting_dispatch"
                           attrs="{'invisible': [('state', 'not in', ('awaiting_boxing', 'awaiting_dispatch'))]}"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="awaiting_dispatch,dispatched"
                           attrs="{'invisible': [('state', '!=', 'dispatched')]}"/>
                </header>
                <sheet class="o_cdu_prescription_sheet">
                    <div class="oe_title o_cdu_record_hero">
                        <span class="o_cdu_record_eyebrow">Prescription record</span>
                        <h1><field name="name"/></h1>
                        <p class="o_cdu_record_subtitle">
                            Patient, clinical, medicine, and collection information in one operational record.
                        </p>
                    </div>
                    <group class="o_cdu_summary_grid">
                        <group string="Source" class="o_cdu_section_card">
                            <field name="report_run_id"/>
                            <field name="source_file_name"/>
                            <field name="source_row_number"/>
                            <field name="source_report_generated_at"/>
                            <field name="facility_id"/>
                            <field name="facility_code" readonly="1"/>
                            <field name="prescription_date"/>
                        </group>
                        <group string="Workflow" class="o_cdu_section_card">
                            <field name="batch_id" readonly="1"/>
                            <field name="verified_by"/>
                            <field name="verified_at"/>
                            <field name="validated_by"/>
                            <field name="validated_at"/>
                            <field name="rejection_destination"
                                   attrs="{'invisible': [('state', 'not in', ('rejected_to_call_center', 'rejected_to_facility'))]}"/>
                            <field name="rejection_reason" string="Rejection Reasons"
                                   attrs="{'invisible': [('state', 'not in', ('rejected_to_call_center', 'rejected_to_facility'))]}"/>
                        </group>
                    </group>
                    <notebook class="o_cdu_notebook">
                        <page string="Patient">
                            <group class="o_cdu_section_grid">
                                <group string="Identity" class="o_cdu_section_card">
                                    <field name="patient_id" context="{'default_customer_rank': 1, 'cdu_open_patient_action': True}"/>
                                    <field name="patient_identifier" attrs="{'readonly': [('patient_id', '!=', False)]}"/>
                                    <field name="patient_first_name" attrs="{'readonly': [('patient_id', '!=', False)]}"/>
                                    <field name="hiv_program_id" attrs="{'readonly': [('patient_id', '!=', False)]}"/>
                                    <field name="national_id" attrs="{'readonly': [('patient_id', '!=', False)]}"/>
                                </group>
                                <group string="Contact &amp; Demographics" class="o_cdu_section_card">
                                    <field name="patient_date_of_birth" attrs="{'readonly': [('patient_id', '!=', False)]}"/>
                                    <field name="patient_gender" attrs="{'readonly': [('patient_id', '!=', False)]}"/>
                                    <field name="patient_phone" attrs="{'readonly': [('patient_id', '!=', False)]}"/>
                                    <field name="secondary_contact" attrs="{'readonly': [('patient_id', '!=', False)]}"/>
                                    <field name="patient_address" attrs="{'readonly': [('patient_id', '!=', False)]}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Clinical">
                            <group class="o_cdu_section_grid">
                                <group string="Clinical Details" class="o_cdu_section_card">
                                    <field name="hiv_diagnosis_date"/>
                                    <field name="new_or_revisit"/>
                                    <field name="next_clinical_visit_date"/>
                                    <field name="has_allergies"/>
                                    <field name="allergies"/>
                                </group>
                                <group string="Viral Load" class="o_cdu_section_card">
                                    <field name="latest_vl_collection_date"/>
                                    <field name="latest_vl_result"/>
                                </group>
                            </group>
                        </page>
                        <page string="Prescription">
                            <div class="o_cdu_regimen_heading">
                                <h3>Regimen</h3>
                                <p>Add or remove products directly in the table. Each product has its own dosage instructions.</p>
                            </div>
                            <field name="product_line_ids"
                                   string="Regimen Products"
                                   class="o_cdu_prescription_regimen_list"
                                   attrs="{'readonly': [('state', 'not in', ('awaiting_verification', 'awaiting_validation', 'rejected_to_call_center', 'rejected_to_facility'))]}">
                                <tree editable="bottom" default_order="sequence, id">
                                    <control>
                                        <create string="Add Product"/>
                                    </control>
                                    <field name="sequence" invisible="1"/>
                                    <field name="product_id"
                                           string="Product"
                                           class="o_cdu_regimen_product_column"
                                           context="{'cdu_generic_catalog_label': True}"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="imported_product_name"
                                           string="Imported Product / Regimen"
                                           readonly="1"/>
                                    <field name="dosage_instructions"
                                           string="Dosage / Instructions"
                                           class="o_cdu_regimen_dosage_column"/>
                                    <field name="source" optional="hide"/>
                                </tree>
                            </field>
                            <group class="o_cdu_regimen_schedule">
                                <field name="cdu_days_supply"
                                       string="Duration Days"
                                       readonly="1"/>
                                <field name="next_drug_pickup_date"
                                       string="Next Refill Date"
                                       required="1"/>
                            </group>
                            <group class="o_cdu_section_grid">
                                <group string="Prescription Source" class="o_cdu_section_card">
                                    <field name="regimen_prescribed_raw" string="Imported Regimen"/>
                                    <field name="dosage_instructions" invisible="1"/>
                                    <field name="prescriber_name"/>
                                    <field name="regimen_id"/>
                                </group>
                                <group string="Collection &amp; Supply" class="o_cdu_section_card">
                                    <field name="collection_point_id"/>
                                    <field name="e_locker_district"/>
                                    <field name="facility_days_supply" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Comments">
                            <field name="validation_notes"/>
                        </page>
                        <page string="Rejection History">
                            <field name="rejection_history_ids" readonly="1">
                                <tree create="0" edit="0" delete="0"
                                      decoration-warning="is_active">
                                    <field name="stage"/>
                                    <field name="destination"/>
                                    <field name="reason_ids" widget="many2many_tags"/>
                                    <field name="rejected_by"/>
                                    <field name="rejected_at"/>
                                    <field name="returned_by"/>
                                    <field name="returned_at"/>
                                    <field name="is_active"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_cdu_prescription_search" model="ir.ui.view">
        <field name="name">cdu.prescription.search</field>
        <field name="model">cdu.prescription</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_identifier"/>
                <field name="patient_first_name"/>
                <field name="facility_name"/>
                <field name="collection_point_id"/>
                <separator/>
                <filter string="Created Today"
                        name="created_today"
                        domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Waiting 2+ Days"
                        name="waiting_two_days"
                        domain="[('create_date', '&lt;', (context_today() - relativedelta(days=2)).strftime('%Y-%m-%d')), ('state', 'not in', ('dispatched', 'cancelled'))]"/>
                <filter string="Pickup Within 7 Days"
                        name="pickup_next_seven_days"
                        domain="[('next_drug_pickup_date', '&gt;=', context_today()), ('next_drug_pickup_date', '&lt;=', context_today() + relativedelta(days=7))]"/>
                <filter string="Needs Attention"
                        name="needs_attention"
                        domain="[('state', 'in', ('rejected_to_call_center', 'rejected_to_facility'))]"/>
                <separator/>
                <filter string="Awaiting Verification" name="awaiting_verification" domain="[('state', '=', 'awaiting_verification')]"/>
                <filter string="Awaiting Validation" name="awaiting_validation" domain="[('state', '=', 'awaiting_validation')]"/>
                <filter string="Awaiting Batching" name="awaiting_batching" domain="[('state', '=', 'awaiting_batching')]"/>
                <filter string="Rejected to Call Center" name="rejected_to_call_center" domain="[('state', '=', 'rejected_to_call_center')]"/>
                <filter string="Rejected to Facility" name="rejected_to_facility" domain="[('state', '=', 'rejected_to_facility')]"/>
                <filter string="Awaiting Picking" name="awaiting_picking" domain="[('state', '=', 'awaiting_picking')]"/>
                <filter string="Awaiting Dispensing" name="awaiting_dispensing" domain="[('state', '=', 'awaiting_dispensing')]"/>
                <filter string="Awaiting Bagging / QA" name="awaiting_bagging_qa" domain="[('state', '=', 'awaiting_bagging_qa')]"/>
                <filter string="Awaiting Boxing" name="awaiting_boxing" domain="[('state', '=', 'awaiting_boxing')]"/>
                <filter string="Awaiting Dispatch" name="awaiting_dispatch" domain="[('state', '=', 'awaiting_dispatch')]"/>
                <filter string="Dispatched" name="dispatched" domain="[('state', '=', 'dispatched')]"/>
                <group expand="0" string="Group By">
                    <filter string="Batch" name="group_batch" context="{'group_by': 'batch_id'}"/>
                    <filter string="Collection Point" name="group_collection_point" context="{'group_by': 'collection_point_id'}"/>
                    <filter string="Facility" name="group_facility" context="{'group_by': 'facility_id'}"/>
                    <filter string="Prescription Date" name="group_prescription_date" context="{'group_by': 'prescription_date'}"/>
                    <filter string="Created Day" name="group_created_day" context="{'group_by': 'create_date:day'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cdu_prescription" model="ir.actions.act_window">
        <field name="name">CDU Prescriptions</field>
        <field name="res_model">cdu.prescription</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_cdu_prescription_search"/>
        <field name="context">{'search_default_group_state': 1}</field>
    </record>

    <record id="action_cdu_prescription_awaiting_verification" model="ir.actions.act_window">
        <field name="name">Awaiting Verification</field>
        <field name="res_model">cdu.prescription</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_cdu_prescription_search"/>
        <field name="domain">[('state', '=', 'awaiting_verification')]</field>
    </record>

    <record id="action_cdu_prescription_awaiting_validation" model="ir.actions.act_window">
        <field name="name">Awaiting Validation</field>
        <field name="res_model">cdu.prescription</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_cdu_prescription_search"/>
        <field name="domain">[('state', '=', 'awaiting_validation')]</field>
    </record>

    <record id="action_cdu_prescription_awaiting_batching" model="ir.actions.act_window">
        <field name="name">Awaiting Batching</field>
        <field name="res_model">cdu.prescription</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_cdu_prescription_search"/>
        <field name="domain">[('state', '=', 'awaiting_batching')]</field>
    </record>

    <record id="action_cdu_prescription_awaiting_dispensing" model="ir.actions.act_window">
        <field name="name">Awaiting Dispensing</field>
        <field name="res_model">cdu.prescription</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_cdu_prescription_search"/>
        <field name="domain">[('state', '=', 'awaiting_dispensing')]</field>
        <field name="context">{'search_default_group_batch': 1, 'search_default_group_collection_point': 1}</field>
    </record>

    <record id="action_cdu_prescription_rejected_to_call_center" model="ir.actions.act_window">
        <field name="name">Rejected to Call Center</field>
        <field name="res_model">cdu.prescription</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_cdu_prescription_search"/>
        <field name="domain">[('state', '=', 'rejected_to_call_center')]</field>
    </record>
</odoo>
