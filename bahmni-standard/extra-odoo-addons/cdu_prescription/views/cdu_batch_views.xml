<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_cdu_batch_tree" model="ir.ui.view">
        <field name="name">cdu.batch.tree</field>
        <field name="model">cdu.batch</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="create_date"/>
                <field name="filter_refill_date"/>
                <field name="filter_diagnosis"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_cdu_batch_form" model="ir.ui.view">
        <field name="name">cdu.batch.form</field>
        <field name="model">cdu.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm_batch" string="Confirm Batch" type="object" class="btn-primary" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <!-- Print button will be added here in the next step -->
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,printed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Primary Filters">
                            <field name="filter_diagnosis" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="filter_refill_date" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="filter_repeat_count" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                        <group string="Secondary Filters">
                            <field name="filter_collection_point_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="filter_facility_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Prescriptions in Batch">
                            <!-- Readonly tree to display the dynamic results -->
                            <field name="prescription_ids" attrs="{'readonly': [('state', '!=', 'draft')]}">
                                <tree create="false" delete="true">
                                    <field name="barcode"/>
                                    <field name="patient_identifier"/>
                                    <field name="facility_name"/>
                                    <field name="collection_point_id"/>
                                    <field name="refill_date"/>
                                    <field name="state" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cdu_batch" model="ir.actions.act_window">
        <field name="name">Workload Batches</field>
        <field name="res_model">cdu.batch</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>