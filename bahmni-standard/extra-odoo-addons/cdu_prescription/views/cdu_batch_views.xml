<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cdu_batch_tree" model="ir.ui.view">
        <field name="name">cdu.batch.tree</field>
        <field name="model">cdu.batch</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="filter_next_drug_pickup_date_from"/>
                <field name="filter_next_drug_pickup_date_to"/>
                <field name="filter_e_locker_district"/>
                <field name="filter_collection_point_id"/>
                <field name="prescription_count"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_cdu_batch_form" model="ir.ui.view">
        <field name="name">cdu.batch.form</field>
        <field name="model">cdu.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm_batch" string="Confirm Batch" type="object" class="btn-primary" groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_mark_printed" string="Mark Picking List Printed" type="object" groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin" attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                    <button name="action_mark_done" string="Mark Done" type="object" groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin" attrs="{'invisible': [('state', 'not in', ('confirmed', 'printed'))]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,printed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Batch Filters">
                            <separator string="Next Drug Pickup Date"/>
                            <field name="filter_next_drug_pickup_date_from" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="filter_next_drug_pickup_date_to" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <separator string="Destination"/>
                            <field name="filter_e_locker_district" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            <field name="filter_collection_point_id" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                        </group>
                        <group string="Summary">
                            <field name="prescription_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Selected Prescriptions">
                            <div class="alert alert-info" role="alert" attrs="{'invisible': [('state', '!=', 'draft')]}">
                                All prescriptions matching the filters are selected by default. Remove any prescription that should not be included before confirming the batch.
                            </div>
                            <field name="prescription_ids" attrs="{'readonly': [('state', '!=', 'draft')]}">
                                <tree create="false" delete="true">
                                    <field name="name"/>
                                    <field name="patient_identifier"/>
                                    <field name="patient_first_name"/>
                                    <field name="facility_name"/>
                                    <field name="next_drug_pickup_date"/>
                                    <field name="e_locker_district"/>
                                    <field name="collection_point_id"/>
                                    <field name="hiv_program_id"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_cdu_batch" model="ir.actions.act_window">
        <field name="name">Workload Batches</field>
        <field name="res_model">cdu.batch</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
