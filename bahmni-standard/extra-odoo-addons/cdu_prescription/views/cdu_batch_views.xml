<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cdu_batch_tree" model="ir.ui.view">
        <field name="name">cdu.batch.tree</field>
        <field name="model">cdu.batch</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-success="state == 'done'">
                <field name="name"/>
                <field name="filter_next_drug_pickup_date_from"/>
                <field name="filter_next_drug_pickup_date_to"/>
                <field name="filter_e_locker_district"/>
                <field name="filter_collection_point_id"/>
                <field name="prescription_count"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_cdu_batch_form" model="ir.ui.view">
        <field name="name">cdu.batch.form</field>
        <field name="model">cdu.batch</field>
        <field name="arch" type="xml">
            <form class="o_cdu_batch_form">
                <header>
                    <button name="action_confirm_batch" string="Confirm Batch" type="object" class="btn-primary" groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin" attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_generate_picking_list" string="Generate Picking List" type="object" class="btn-primary" groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin" attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                    <button name="action_mark_printed" string="Mark Picking List Printed" type="object" groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin" attrs="{'invisible': [('state', '!=', 'picking_generated')]}"/>
                    <button name="action_mark_done" string="Mark Done" type="object" groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin" attrs="{'invisible': [('state', 'not in', ('picking_generated', 'printed'))]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,picking_generated,printed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <div class="o_cdu_batch_dashboard">
                        <div class="o_cdu_batch_card">
                            <h3>Pickup Dates</h3>
                            <div class="o_cdu_batch_card_fields">
                                <label for="filter_next_drug_pickup_date_from"/>
                                <field name="filter_next_drug_pickup_date_from" nolabel="1" required="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <label for="filter_next_drug_pickup_date_to"/>
                                <field name="filter_next_drug_pickup_date_to" nolabel="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </div>
                        </div>
                        <div class="o_cdu_batch_card">
                            <h3>Destination</h3>
                            <div class="o_cdu_batch_card_fields">
                                <label for="filter_e_locker_district"/>
                                <field name="filter_e_locker_district" nolabel="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <label for="filter_collection_point_id"/>
                                <field name="filter_collection_point_id" nolabel="1" attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                            </div>
                        </div>
                    </div>
                    <div class="o_cdu_batch_table_context">
                        <span class="o_cdu_batch_count_badge">
                            <field name="prescription_count" readonly="1" nolabel="1"/>
                            <span>prescriptions selected</span>
                        </span>
                    </div>
                    <div class="o_cdu_repeat_control_panel">
                        <div class="o_cdu_repeat_control_title">REGIMEN REPEAT DAYS</div>
                        <field name="repeat_apply_regimen_domain_ids" invisible="1"/>
                        <div class="o_cdu_repeat_control_fields">
                            <field name="repeat_apply_line_ids"
                                   nolabel="1"
                                   class="o_cdu_regimen_repeat_table"
                                   context="{'display_regimen_prescribed_raw': True}">
                                <tree editable="bottom" create="true" delete="true">
                                    <control>
                                        <create string="Add Regimen"/>
                                    </control>
                                    <field name="regimen_prescription_id"
                                           string="Regimen"
                                           domain="[('id', 'in', parent.repeat_apply_regimen_domain_ids)]"
                                           context="{'display_regimen_prescribed_raw': True}"
                                           class="o_cdu_regimen_repeat_regimen_cell"
                                           placeholder="Select Regimen"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="days_to_serve_input"
                                           string="Repeat Days To Serve"
                                           class="o_cdu_regimen_repeat_days_cell"/>
                                </tree>
                            </field>
                            <button name="action_apply_regimen_repeat_days"
                                    string="Apply"
                                    type="object"
                                    class="btn-primary o_cdu_repeat_apply_button"/>
                        </div>
                    </div>
                    <notebook>
                        <page string="Selected Prescriptions">
                            <div class="alert alert-info" role="alert" attrs="{'invisible': [('state', '!=', 'draft')]}">
                                All prescriptions matching the filters are selected by default. Remove any prescription that should not be included before confirming the batch.
                            </div>
                            <field name="prescription_ids" attrs="{'readonly': [('state', '!=', 'draft')]}">
                                <tree create="false" delete="true" editable="bottom">
                                    <field name="name" readonly="1"/>
                                    <field name="patient_identifier" optional="hide" readonly="1"/>
                                    <field name="patient_first_name" readonly="1"/>
                                    <field name="facility_name" readonly="1"/>
                                    <field name="next_drug_pickup_date" readonly="1"/>
                                    <field name="cdu_days_supply" string="CDU Days" readonly="1"/>
                                    <field name="repeat_days" string="Repeats in Days" class="o_cdu_repeat_days_input_cell"/>
                                    <field name="regimen_prescribed_raw" readonly="1"/>
                                    <field name="e_locker_district" readonly="1"/>
                                    <field name="collection_point_id" readonly="1"/>
                                    <field name="hiv_program_id" optional="hide" readonly="1"/>
                                    <field name="state" readonly="1"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Picking Summary"
                            attrs="{'invisible': [('state', '=', 'draft')]}"
                            groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin">

                            <field name="picking_line_ids" readonly="1">

                                <tree create="0" delete="0">

                                    <!-- PRODUCT -->
                                    <field name="product_id"/>

                                    <!-- PACK SIZE -->
                                    <field name="pack_size"/>

                                    <!-- CDU OPERATIONAL -->
                                    <field name="total_bottles"/>

                                    <!-- TOTAL UNITS -->
                                    <field name="total_tablets"/>

                                    <!-- PATIENT COUNT -->
                                    <field name="prescription_count"/>

                                </tree>

                            </field>

                        </page>


                        
                        <page string="Patient Picking Lines"
                            attrs="{'invisible': [('state', '=', 'draft')]}"
                            groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin">

                            <field
                                name="patient_picking_line_ids"
                            >

                                <tree editable="bottom" create="0" delete="0">

                                    <!-- PATIENT -->
                                    <field name="patient_id" string="Patient"/>

                                    <field name="drug_name" string="Product/Drug" readonly="1"/>

                                    <field name="daily_dose" string="Daily Dose" readonly="1"/>

                                    <field name="facility_days_supply" string="Facility Days Supply" readonly="1"/>

                                    <field name="cdu_days" string="CDU Days" readonly="1"/>

                                    <field name="regimen_repeat_days" string="Regimen Repeat Days" readonly="1"/>

                                    <field name="prescription_repeat_days" string="Prescription Repeat Days"/>

                                    <field name="effective_repeat_days" string="Effective Repeat Days" readonly="1"/>

                                </tree>

                            </field>

                        </page>

                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_cdu_batch" model="ir.actions.act_window">
        <field name="name">Workload Batches</field>
        <field name="res_model">cdu.batch</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
