<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cdu_production_skip_wizard_form" model="ir.ui.view">
        <field name="name">cdu.production.skip.wizard.form</field>
        <field name="model">cdu.production.skip.wizard</field>
        <field name="arch" type="xml">
            <form string="Skip for Now">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        This prescription stays in the current queue and moves behind items that are ready.
                        Its downstream position will be assigned only when the work is completed.
                    </div>
                    <group>
                        <field name="prescription_id"/>
                        <field name="stage"/>
                        <field name="reason"
                               placeholder="Why can this prescription not be completed now?"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_skip"
                            string="Skip for Now"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
