<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="ir_cron_cdu_eregister_pull" model="ir.cron">
        <field name="name">CDU eRegister: Pull New Prescriptions</field>
        <field name="model_id" ref="model_cdu_eregister_sync"/>
        <field name="state">code</field>
        <field name="code">model.cron_pull_new_prescriptions()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_cdu_eregister_push_status" model="ir.cron">
        <field name="name">CDU eRegister: Publish Fulfilment Status</field>
        <field name="model_id" ref="model_cdu_eregister_sync"/>
        <field name="state">code</field>
        <field name="code">model.cron_push_pending_statuses()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_cdu_eregister_cancellations" model="ir.cron">
        <field name="name">CDU eRegister: Check Cancellations</field>
        <field name="model_id" ref="model_cdu_eregister_sync"/>
        <field name="state">code</field>
        <field name="code">model.cron_check_cancellations()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
