<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cdu_box_tree" model="ir.ui.view">
        <field name="name">cdu.box.tree</field>
        <field name="model">cdu.box</field>
        <field name="arch" type="xml">
            <tree class="o_cdu_production_list"
                  default_order="create_date desc"
                  decoration-success="state == 'confirmed'">
                <field name="name"/>
                <field name="collection_point_id"/>
                <field name="next_drug_pickup_date"/>
                <field name="parcel_count"/>
                <field name="max_parcels"/>
                <field name="dispatch_status"
                       widget="badge"
                       decoration-warning="dispatch_status == 'pending'"
                       decoration-success="dispatch_status == 'dispatched'"/>
                <field name="collect_go_status"
                       widget="badge"
                       decoration-info="collect_go_status in ('not_submitted', 'submitted')"
                       decoration-success="collect_go_status == 'processed'"
                       decoration-danger="collect_go_status in ('failed', 'retry_limit_reached')"/>
                <field name="confirmed_by"/>
                <field name="confirmed_at"/>
                <field name="dispatched_at"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"/>
            </tree>
        </field>
    </record>

    <record id="view_cdu_box_form" model="ir.ui.view">
        <field name="name">cdu.box.form</field>
        <field name="model">cdu.box</field>
        <field name="arch" type="xml">
            <form class="o_cdu_prescription_form o_cdu_batch_form o_cdu_stage_boxing">
                <header>
                    <button name="action_confirm_box"
                            string="Confirm Box"
                            type="object"
                            class="btn-primary"
                            groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"
                            confirm="This will consume the boxed medicines from the eLMIS Production Floor and move the prescriptions to Awaiting Dispatch. Continue?"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_print_box_documents"
                            string="Print Box Documents"
                            type="object"
                            icon="fa-print"
                            class="btn-secondary"
                            groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"
                            attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                    <button name="action_confirm_dispatch_handover"
                            string="Confirm Dispatch Handover"
                            type="object"
                            class="btn-primary"
                            groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"
                            confirm="This will send the box and its parcels to Collect-and-Go using UpdateParcel. Prescriptions will be marked Dispatched only after Collect-and-Go processing succeeds. Continue?"
                            attrs="{'invisible': ['|', '|', ('state', '!=', 'confirmed'), ('dispatch_status', '=', 'dispatched'), ('collect_go_status', '!=', 'not_submitted')]}"/>
                    <button name="action_retry_collect_go_submission"
                            string="Retry Collect-and-Go"
                            type="object"
                            class="btn-secondary"
                            groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"
                            confirm="This will re-submit the box to Collect-and-Go with a new message reference and link the retry to the original failed request. Continue?"
                            attrs="{'invisible': [('collect_go_status', '!=', 'failed')]}"/>
                    <button name="action_check_collect_go_response"
                            string="Check Collect-and-Go Response"
                            type="object"
                            class="btn-secondary"
                            groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"
                            attrs="{'invisible': [('collect_go_status', '!=', 'submitted')]}"/>
                    <button name="action_poll_collect_go_parcel_status"
                            string="Poll Parcel Status"
                            type="object"
                            class="btn-secondary"
                            groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"
                            attrs="{'invisible': [('collect_go_status', '!=', 'processed')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title o_cdu_workspace_hero">
                        <span class="o_cdu_workspace_eyebrow">Boxing &amp; dispatch workspace</span>
                        <h1><field name="name"/></h1>
                        <p class="o_cdu_workspace_subtitle">
                            Scan approved bags, monitor box capacity, and complete dispatch handover.
                        </p>
                    </div>

                    <div class="o_cdu_batch_dashboard">
                        <div class="o_cdu_batch_card">
                            <h3>Box Rules</h3>
                            <div class="o_cdu_batch_card_fields">
                                <label for="collection_point_id"/>
                                <field name="collection_point_id"
                                       nolabel="1"
                                       readonly="1"
                                       options="{'no_create': True}"/>
                                <label for="next_drug_pickup_date"/>
                                <field name="next_drug_pickup_date" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                        <div class="o_cdu_batch_card">
                            <h3>Capacity</h3>
                            <div class="o_cdu_batch_card_fields">
                                <label for="parcel_count"/>
                                <field name="parcel_count" nolabel="1" readonly="1"/>
                                <label for="max_parcels"/>
                                <field name="max_parcels" nolabel="1" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            </div>
                        </div>
                        <div class="o_cdu_batch_card">
                            <h3>Confirmation</h3>
                            <div class="o_cdu_batch_card_fields">
                                <label for="confirmed_by"/>
                                <field name="confirmed_by" nolabel="1" readonly="1"/>
                                <label for="confirmed_at"/>
                                <field name="confirmed_at" nolabel="1" readonly="1"/>
                                <label for="consumption_posted_at"/>
                                <field name="consumption_posted_at" nolabel="1" readonly="1"/>
                                <label for="consumption_log_id"/>
                                <field name="consumption_log_id" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                        <div class="o_cdu_batch_card">
                            <h3>Dispatch</h3>
                            <div class="o_cdu_batch_card_fields">
                                <label for="dispatch_status"/>
                                <field name="dispatch_status" nolabel="1" readonly="1"/>
                                <label for="collect_go_status"/>
                                <field name="collect_go_status" nolabel="1" readonly="1"/>
                                <label for="collect_go_latest_parcel_status_summary"/>
                                <field name="collect_go_latest_parcel_status_summary" nolabel="1" readonly="1"/>
                                <label for="dispatch_ready_at"/>
                                <field name="dispatch_ready_at" nolabel="1" readonly="1"/>
                                <label for="dispatched_by"/>
                                <field name="dispatched_by" nolabel="1" readonly="1"/>
                                <label for="dispatched_at"/>
                                <field name="dispatched_at" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info o_cdu_elmis_fulfilment_hint" role="alert">
                        Scan the barcode on each bag label below. When the next scanned parcel belongs to a different
                        collection point, or the current box reaches max parcels, the current box is closed and a new
                        box is opened automatically.
                    </div>

                    <notebook class="o_cdu_workspace_notebook">
                        <page string="Parcels">
                            <div class="o_cdu_box_scan_bar"
                                 attrs="{'invisible': [('state', '=', 'confirmed')]}">
                                <field name="bag_label_scan_input"
                                       widget="cdu_box_bag_label_scan_input"
                                       placeholder="Scan bag label barcode"
                                       nolabel="1"/>
                            </div>
                            <field name="line_ids" attrs="{'readonly': [('state', '=', 'confirmed')]}">
                                <tree editable="bottom" default_order="parcel_reference asc">
                                    <field name="bagging_qa_id"
                                           domain="[('state', '=', 'confirmed'), ('prescription_id.state', '=', 'awaiting_boxing')]"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="parcel_reference" readonly="1"/>
                                    <field name="patient_name" readonly="1"/>
                                    <field name="collection_point_id" readonly="1"/>
                                    <field name="next_drug_pickup_date" readonly="1"/>
                                    <field name="collect_go_parcel_status" readonly="1"/>
                                    <field name="collect_go_parcel_status_type" optional="hide" readonly="1"/>
                                    <field name="collect_go_status_received_at" optional="hide" readonly="1"/>
                                    <field name="collect_go_status_date" optional="hide" readonly="1"/>
                                    <field name="prescription_id" optional="hide" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Dispatch Notes">
                            <field name="dispatch_notes"
                                   placeholder="Capture handover notes, courier reference, or any dispatch exception here."
                                   attrs="{'readonly': [('dispatch_status', '=', 'dispatched')]}"/>
                        </page>
                        <page string="Collect-and-Go">
                            <group>
                                <group string="Status">
                                    <field name="collect_go_status" readonly="1"/>
                                    <field name="collect_go_reference_guid" readonly="1"/>
                                    <field name="collect_go_submitted_at" readonly="1"/>
                                    <field name="collect_go_processed_at" readonly="1"/>
                                    <field name="collect_go_last_status_poll_at" readonly="1"/>
                                    <field name="collect_go_latest_parcel_status_summary" readonly="1"/>
                                    <field name="collect_go_last_log_id" readonly="1"/>
                                </group>
                                <group string="Latest Error">
                                    <field name="collect_go_error" readonly="1" nolabel="1"/>
                                </group>
                            </group>
                            <field name="collect_go_log_ids" readonly="1">
                                <tree>
                                    <field name="timestamp"/>
                                    <field name="call_type"/>
                                    <field name="reference_guid"/>
                                    <field name="http_status_code"/>
                                    <field name="bridge_status_code"/>
                                    <field name="success"/>
                                    <field name="error_message"/>
                                    <field name="retry_count"/>
                                    <field name="user_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_cdu_box_search" model="ir.ui.view">
        <field name="name">cdu.box.search</field>
        <field name="model">cdu.box</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="collection_point_id"/>
                <field name="next_drug_pickup_date"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Pending Dispatch" name="pending_dispatch" domain="[('state', '=', 'confirmed'), ('dispatch_status', '=', 'pending')]"/>
                <filter string="Dispatched" name="dispatched" domain="[('dispatch_status', '=', 'dispatched')]"/>
                <filter string="Collect-and-Go Failed" name="collect_go_failed" domain="[('collect_go_status', '=', 'failed')]"/>
                <filter string="Collect-and-Go Retry Limit" name="collect_go_retry_limit" domain="[('collect_go_status', '=', 'retry_limit_reached')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Dispatch Status" name="group_dispatch_status" context="{'group_by': 'dispatch_status'}"/>
                    <filter string="Collect-and-Go Status" name="group_collect_go_status" context="{'group_by': 'collect_go_status'}"/>
                    <filter string="Collection Point" name="group_collection_point" context="{'group_by': 'collection_point_id'}"/>
                    <filter string="Pickup Date" name="group_pickup_date" context="{'group_by': 'next_drug_pickup_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cdu_box" model="ir.actions.act_window">
        <field name="name">Boxes</field>
        <field name="res_model">cdu.box</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_cdu_box_search"/>
    </record>

    <record id="action_cdu_boxing" model="ir.actions.act_window">
        <field name="name">Boxing</field>
        <field name="res_model">cdu.box</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_cdu_box_search"/>
        <field name="domain">[('state', '=', 'draft')]</field>
        <field name="context">{'default_state': 'draft'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a box and scan approved bag-label barcodes.
            </p>
            <p>
                Draft boxes remain here so boxing can be continued without losing progress.
            </p>
        </field>
    </record>

    <record id="action_cdu_dispatch_work_queue" model="ir.actions.act_window">
        <field name="name">Dispatch Work Queue</field>
        <field name="res_model">cdu.box</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_cdu_box_search"/>
        <field name="domain">[('state', '=', 'confirmed'), ('dispatch_status', '=', 'pending')]</field>
    </record>

    <record id="action_cdu_boxing_work_queue" model="ir.actions.act_window">
        <field name="name">Boxing Work Queue</field>
        <field name="res_model">cdu.bagging.qa</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_cdu_bagging_qa_search"/>
        <field name="domain">[('state', '=', 'confirmed'), ('prescription_id.state', '=', 'awaiting_boxing')]</field>
    </record>

    <record id="action_cdu_awaiting_dispatch" model="ir.actions.act_window">
        <field name="name">Awaiting Dispatch</field>
        <field name="res_model">cdu.prescription</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="cdu_prescription.view_cdu_prescription_search"/>
        <field name="domain">[('state', '=', 'awaiting_dispatch')]</field>
    </record>
</odoo>
