<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cdu_batch_form_elmis" model="ir.ui.view">
        <field name="name">cdu.batch.form.elmis</field>
        <field name="model">cdu.batch</field>
        <field name="inherit_id" ref="cdu_prescription.view_cdu_batch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_mark_printed']" position="before">
                <button name="action_authenticate_elmis"
                        string="Authenticate eLMIS"
                        type="object"
                        class="btn-secondary"
                        groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"
                        attrs="{'invisible': [('state', 'not in', ('confirmed', 'picking_generated', 'printed'))]}"/>
                <button name="action_refresh_store_stock"
                        string="Refresh Store Stock"
                        type="object"
                        class="btn-secondary"
                        groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"
                        attrs="{'invisible': [('state', 'not in', ('picking_generated', 'printed'))]}"/>
                <button name="action_calculate_residual_stock"
                        string="Calculate Residual Stock"
                        type="object"
                        class="btn-secondary"
                        groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"
                        attrs="{'invisible': [('picking_confirmed_at', '=', False)]}"/>
                <button name="action_return_residual_stock"
                        string="Return Residual Stock"
                        type="object"
                        class="btn-primary"
                        groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"
                        confirm="This will submit residual stock events to eLMIS: debit CDU Production Floor, then credit CDU Store. Continue?"
                        attrs="{'invisible': ['|', ('picking_confirmed_at', '=', False), ('residual_returned_at', '!=', False)]}"/>
            </xpath>
            <xpath expr="//div[contains(@class, 'o_cdu_batch_dashboard')]" position="inside">
                <div class="o_cdu_batch_card">
                    <h3>eLMIS Status</h3>
                    <div class="o_cdu_batch_card_fields">
                        <label for="stock_event_status"/>
                        <field name="stock_event_status" nolabel="1" readonly="1"/>
                        <label for="store_stock_refreshed_at"/>
                        <field name="store_stock_refreshed_at" nolabel="1" readonly="1"/>
                        <label for="picking_ready"/>
                        <field name="picking_ready" nolabel="1" readonly="1"/>
                    </div>
                </div>
                <div class="o_cdu_batch_card">
                    <h3>Milestones</h3>
                    <div class="o_cdu_batch_card_fields">
                        <label for="picking_confirmed_at"/>
                        <field name="picking_confirmed_at" nolabel="1" readonly="1"/>
                        <label for="boxing_completed_at"/>
                        <field name="boxing_completed_at" nolabel="1" readonly="1"/>
                        <label for="residual_returned_at"/>
                        <field name="residual_returned_at" nolabel="1" readonly="1"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[contains(@class, 'o_cdu_batch_table_context')]" position="inside">
                <span class="o_cdu_batch_readiness_badge o_cdu_batch_readiness_ready" attrs="{'invisible': [('picking_ready', '=', False)]}">
                    <span>Ready for picking</span>
                </span>
                <button name="action_print_elmis_picking_list"
                        string="Print Picking List"
                        type="object"
                        class="btn-primary"
                        groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"
                        attrs="{'invisible': [('state', 'not in', ('picking_generated', 'printed'))]}"/>
                <span class="o_cdu_batch_readiness_badge o_cdu_batch_readiness_needs_attention" attrs="{'invisible': [('picking_ready', '=', True)]}">
                    <span>Picking needs attention</span>
                </span>
            </xpath>
            <xpath expr="//div[contains(@class, 'o_cdu_batch_table_context')]" position="after">
                <div class="o_cdu_batch_readiness_message" attrs="{'invisible': [('picking_ready', '=', True)]}">
                    <span>Picking selections are incomplete.</span>
                    <button name="action_open_elmis_picking_wizard"
                            string="Open stock selection"
                            type="object"
                            class="btn-link p-0"
                            groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"/>
                </div>
            </xpath>
            <xpath expr="//page[field[@name='picking_line_ids']]" position="replace">
                <page string="Picking Summary"
                      groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin">
                    <field name="picking_line_ids" readonly="1">
                        <tree>
                            <field name="unmapped_drug_name" string="Regimen"/>
                            <field name="elmis_product_name" string="eLMIS Product"/>
                            <field name="pack_size"/>
                            <field name="total_tablets" string="Total Units (CDU)"/>
                            <field name="total_bottles" string="Total Bottles (CDU)"/>
                            <field name="prescription_count"/>
                        </tree>
                    </field>
                </page>
            </xpath>
            <xpath expr="//page[field[@name='patient_picking_line_ids']]" position="replace">
                <page string="Patient Picking Lines"
                      groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin">
                    <div class="o_cdu_patient_pick_table">
                        <div class="o_cdu_patient_pick_header">
                            <span>Patient</span>
                            <span>Medication</span>
                            <span>Daily dose</span>
                            <span>Days to dispense</span>
                            <span>To pick</span>
                            <span>Next pickup</span>
                            <span/>
                        </div>
                        <field name="patient_picking_line_ids"
                               mode="kanban"
                               readonly="1"
                               class="o_cdu_patient_pick_lines">
                            <kanban create="0" delete="0" edit="0" class="o_cdu_patient_pick_kanban">
                                <field name="patient_id"/>
                                <field name="medication_display"/>
                                <field name="regimen_code_display"/>
                                <field name="daily_dose_display"/>
                                <field name="days_to_dispense_display"/>
                                <field name="to_pick_pack_display"/>
                                <field name="to_pick_units_display"/>
                                <field name="calculated_next_pickup_date"/>
                                <field name="next_pickup_supply_display"/>
                                <field name="picking_variance_label"/>
                                <field name="picking_variance_class"/>
                                <field name="prescribed_days_display"/>
                                <field name="facility_cap_display"/>
                                <field name="cdu_cycle_display"/>
                                <field name="regimen_override_display"/>
                                <field name="required_units_display"/>
                                <field name="picked_units_display"/>
                                <field name="back_order_display"/>
                                <templates>
                                    <t t-name="kanban-box">
                                        <details class="o_cdu_patient_pick_record">
                                            <summary class="o_cdu_patient_pick_summary">
                                                <span class="o_cdu_patient_pick_cell o_cdu_patient_pick_patient">
                                                    <field name="patient_id"/>
                                                </span>
                                                <span class="o_cdu_patient_pick_cell o_cdu_patient_pick_medication">
                                                    <strong><field name="medication_display"/></strong>
                                                    <small><field name="regimen_code_display"/></small>
                                                </span>
                                                <span class="o_cdu_patient_pick_cell">
                                                    <field name="daily_dose_display"/>
                                                </span>
                                                <span class="o_cdu_patient_pick_cell">
                                                    <strong><field name="days_to_dispense_display"/></strong>
                                                </span>
                                                <span class="o_cdu_patient_pick_cell">
                                                    <strong><field name="to_pick_pack_display"/></strong>
                                                    <small><field name="to_pick_units_display"/></small>
                                                </span>
                                                <span class="o_cdu_patient_pick_cell">
                                                    <strong>
                                                        <t t-if="record.calculated_next_pickup_date.raw_value">
                                                            <field name="calculated_next_pickup_date"/>
                                                        </t>
                                                        <t t-else="">-</t>
                                                    </strong>
                                                    <small><field name="next_pickup_supply_display"/></small>
                                                    <t t-if="record.picking_variance_label.raw_value">
                                                        <em t-att-class="'o_cdu_patient_pick_badge ' + (record.picking_variance_class.raw_value || '')">
                                                            <field name="picking_variance_label"/>
                                                        </em>
                                                    </t>
                                                </span>
                                                <span class="o_cdu_patient_pick_toggle" aria-hidden="true"/>
                                            </summary>
                                            <div class="o_cdu_patient_pick_detail">
                                                <div>
                                                    <span>Prescribed</span>
                                                    <strong><field name="prescribed_days_display"/></strong>
                                                </div>
                                                <div>
                                                    <span>Facility cap</span>
                                                    <strong><field name="facility_cap_display"/></strong>
                                                </div>
                                                <div>
                                                    <span>CDU cycle</span>
                                                    <strong><field name="cdu_cycle_display"/></strong>
                                                </div>
                                                <div>
                                                    <span>Regimen override</span>
                                                    <strong><field name="regimen_override_display"/></strong>
                                                </div>
                                                <div>
                                                    <span>Required</span>
                                                    <strong><field name="required_units_display"/></strong>
                                                </div>
                                                <div>
                                                    <span>Picked</span>
                                                    <strong><field name="picked_units_display"/></strong>
                                                </div>
                                                <div>
                                                    <span>Back order</span>
                                                    <strong><field name="back_order_display"/></strong>
                                                </div>
                                            </div>
                                        </details>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </div>
                </page>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Available eLMIS Stock">
                    <div class="alert alert-info o_cdu_elmis_empty_stock_hint"
                         role="alert"
                         attrs="{'invisible': [('elmis_stock_option_ids', '!=', [])]}">
                        No eLMIS stock has been loaded for this batch yet. Click
                        <strong>Refresh Store Stock</strong> or
                        <strong>Generate Picking List</strong> to fetch current CDU Store stock.
                    </div>
                    <field name="elmis_stock_option_ids" readonly="1">
                        <tree create="0" delete="0" default_order="orderable_name asc, expiration_date asc, lot asc">
                            <field name="orderable_name" string="Product"/>
                            <field name="lot" string="Batch Number"/>
                            <field name="stock_on_hand"/>
                            <field name="expiration_date"/>
                            <field name="occurred_date"/>
                            <field name="orderable_code" optional="hide"/>
                            <field name="orderable_id" optional="hide"/>
                            <field name="lot_id" optional="hide"/>
                            <field name="facility_code" optional="hide"/>
                            <field name="program_code" optional="hide"/>
                        </tree>
                    </field>
                </page>
                <page string="eLMIS Picking Selections">
                    <button name="action_open_elmis_picking_wizard"
                            string="Revise Selection"
                            type="object"
                            class="btn-secondary"
                            groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"
                            attrs="{'invisible': [('state', '!=', 'picking_generated')]}"/>
                    <div class="alert alert-info o_cdu_elmis_fulfilment_hint" role="alert">
                        Each eRegister drug/regimen below is generated from the prescriptions in this batch.
                        Add one or more eLMIS fulfilment rows for each regimen when multiple eLMIS products
                        or lots are needed.
                    </div>
                    <div class="o_cdu_elmis_section_title">eRegister requirements</div>
                    <field name="elmis_picking_line_ids" readonly="1">
                        <tree create="0" delete="0" default_order="openmrs_drug_name asc">
                            <field name="batch_id" invisible="1"/>
                            <field name="summary_line_id" readonly="1" optional="hide"/>
                            <field name="openmrs_drug_name" readonly="1"/>
                            <field name="openmrs_drug_uuid" readonly="1" optional="hide"/>
                            <field name="prescription_count" readonly="1"/>
                            <field name="required_units" readonly="1" optional="show"/>
                            <field name="available_quantity" readonly="1" optional="hide"/>
                            <field name="picked_quantity" readonly="1" optional="show"/>
                            <field name="remaining_quantity" readonly="1" optional="show"/>
                            <field name="quantity_to_pick" readonly="1"/>
                        </tree>
                    </field>
                    <div class="o_cdu_elmis_section_title">Fulfil with eLMIS stock</div>
                    <field name="elmis_picking_fulfilment_line_ids"
                           attrs="{'readonly': [('state', 'in', ('picking_generated', 'printed', 'done'))]}">
                        <tree editable="bottom" default_order="openmrs_drug_name asc, selected_orderable_name asc, selected_lot asc">
                            <field name="batch_id" invisible="1"/>
                            <field name="picking_line_id"
                                   options="{'no_create': True, 'no_open': True}"
                                   required="1"/>
                            <field name="openmrs_drug_name" readonly="1" optional="hide"/>
                            <field name="required_quantity" readonly="1"/>
                            <field name="selected_stock_option_id" string="Fulfil With" options="{'no_create': True, 'no_open': True}"/>
                            <field name="selected_orderable_name" invisible="1" force_save="1"/>
                            <field name="selected_lot" string="Batch Number" readonly="1" force_save="1"/>
                            <field name="selected_lot_expiry" string="Expiry Date" readonly="1" force_save="1"/>
                            <field name="selected_stock_on_hand" readonly="1" force_save="1"/>
                            <field name="quantity_picked"/>
                            <field name="selected_orderable_code" invisible="1" force_save="1"/>
                            <field name="selected_orderable_id" invisible="1" force_save="1"/>
                            <field name="selected_lot_id" invisible="1" force_save="1"/>
                        </tree>
                    </field>
                </page>
                <page string="eLMIS API Logs">
                    <field name="stock_event_log_ids" readonly="1">
                        <tree decoration-danger="not success" decoration-success="success">
                            <field name="timestamp"/>
                            <field name="call_type"/>
                            <field name="http_method"/>
                            <field name="http_status_code"/>
                            <field name="success"/>
                            <field name="retry_count"/>
                        </tree>
                    </field>
                </page>
                <page string="Residual Return">
                    <div class="alert alert-info o_cdu_elmis_fulfilment_hint" role="alert">
                        Residual stock is calculated as <strong>picked quantity minus dispensed quantity</strong>
                        for each eLMIS product and batch number. Return residual stock only after the
                        batch has finished boxing.
                    </div>
                    <field name="residual_return_line_ids" readonly="1">
                        <tree create="0" delete="0" default_order="orderable_name asc, lot_expiry asc, lot asc"
                              decoration-success="residual_qty &gt; 0">
                            <field name="orderable_name"/>
                            <field name="lot"/>
                            <field name="lot_expiry"/>
                            <field name="picked_qty"/>
                            <field name="dispensed_qty"/>
                            <field name="residual_qty"/>
                            <field name="orderable_code" optional="hide"/>
                            <field name="orderable_id" optional="hide"/>
                            <field name="lot_id" optional="hide"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
