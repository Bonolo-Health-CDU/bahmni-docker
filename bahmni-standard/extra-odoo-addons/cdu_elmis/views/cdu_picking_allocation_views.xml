<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cdu_picking_line_bulk_allocation_form" model="ir.ui.view">
        <field name="name">cdu.picking.line.bulk.allocation.form</field>
        <field name="model">cdu.picking.line</field>
        <field name="arch" type="xml">
            <form string="Regimen Component Allocation">
                <header>
                    <button name="action_confirm_picking"
                            string="Confirm Picking"
                            type="object"
                            class="btn-primary"
                            confirm="This locks all allocations and moves the selected stock from CDU Store to Production Floor. Continue?"
                            groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"/>
                    <button name="action_back_to_allocation_overview"
                            string="Back to Regimen Overview"
                            type="object"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <field name="batch_id" invisible="1"/>
                    <field name="allocation_mode" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="openmrs_drug_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="prescription_count" readonly="1"/>
                        <field name="allocation_progress" readonly="1"/>
                        <field name="allocation_status" widget="badge" readonly="1"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Add as many components as the regimen requires. Every component
                        automatically includes every prescription and allocates its own
                        selected products and lots. Overall coverage is determined by
                        the least-covered component.
                    </div>
                    <separator string="Regimen Components"/>
                    <field name="bulk_group_ids"
                           context="{'default_batch_id': batch_id,
                                     'default_picking_line_id': id}">
                        <tree>
                            <control>
                                <create string="Add Component"/>
                            </control>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="selected_products_display"/>
                            <field name="selected_pack_sizes_display"/>
                            <field name="required_units"/>
                            <field name="available_packs"/>
                            <field name="allocated_packs"/>
                            <field name="supplied_units"/>
                            <field name="excess_units"/>
                            <field name="distribution_stale"/>
                        </tree>
                    </field>
                    <separator string="Prescription Status / Stock Exceptions"/>
                    <field name="resolution_ids">
                        <tree editable="bottom" create="0" delete="0"
                              decoration-danger="status == 'unserved'"
                              decoration-warning="status == 'partial'"
                              decoration-success="status == 'full'">
                            <field name="sequence" readonly="1"/>
                            <field name="prescription_id" readonly="1"/>
                            <field name="patient_id" readonly="1"/>
                            <field name="status" widget="badge" readonly="1"/>
                            <field name="target_days" readonly="1"/>
                            <field name="allocated_packs" readonly="1"/>
                            <field name="supplied_units" readonly="1"/>
                            <field name="coverage_days" readonly="1"/>
                            <field name="unserved_reason" readonly="1"/>
                            <field name="unserved_note"/>
                            <button name="action_mark_unserved"
                                    string="Mark Unserved"
                                    type="object"
                                    icon="fa-ban"
                                    confirm="Mark this prescription unserved because of insufficient stock?"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cdu_picking_bulk_group_tree" model="ir.ui.view">
        <field name="name">cdu.picking.bulk.group.tree</field>
        <field name="model">cdu.picking.bulk.group</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="picking_line_id"/>
                <field name="selected_products_display"/>
                <field name="selected_pack_sizes_display"/>
                <field name="required_units"/>
                <field name="available_packs"/>
                <field name="allocated_packs"/>
                <field name="supplied_units"/>
                <field name="excess_units"/>
                <field name="distribution_stale" readonly="1"/>
            </tree>
        </field>
    </record>

    <record id="view_cdu_picking_bulk_group_form" model="ir.ui.view">
        <field name="name">cdu.picking.bulk.group.form</field>
        <field name="model">cdu.picking.bulk.group</field>
        <field name="arch" type="xml">
            <form string="Regimen Component">
                <header>
                    <button name="action_back_to_regimen_overview"
                            string="Back to Regimen Overview"
                            type="object"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <field name="eligible_resolution_ids" invisible="1"/>
                    <field name="locked" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="batch_id" readonly="1"/>
                            <field name="picking_line_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="selected_products_display" readonly="1"/>
                            <field name="selected_pack_sizes_display" readonly="1"/>
                            <field name="available_packs" readonly="1"/>
                            <field name="distribution_stale" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Select the products and lots for this regimen component.
                        Every prescription is included automatically in patient order.
                        Allocation recalculates when selected stock or daily units
                        change, using availability, earliest expiry, minimum excess,
                        then patient order.
                    </div>
                    <notebook>
                        <page string="Selected Products / Lots">
                            <field name="lot_ids"
                                   context="{'default_group_id': active_id}">
                                <tree editable="bottom"
                                      default_order="expiration_date asc, sequence asc">
                                    <field name="batch_id" invisible="1"/>
                                    <field name="sequence" string="Lot Order" widget="handle"/>
                                    <field name="stock_option_id"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="orderable_name" readonly="1"/>
                                    <field name="pack_size" readonly="1"/>
                                    <field name="lot" readonly="1"/>
                                    <field name="expiration_date" readonly="1"/>
                                    <field name="available_packs" readonly="1"/>
                                    <field name="quantity_packs"/>
                                    <field name="allocated_packs" readonly="1"/>
                                    <field name="remaining_selected_packs" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Prescriptions">
                            <field name="member_ids">
                                <tree editable="bottom"
                                      create="0"
                                      delete="0"
                                      default_order="sequence asc">
                                    <field name="picking_line_id" invisible="1"/>
                                    <field name="sequence" string="Patient Order" readonly="1"/>
                                    <field name="resolution_id"
                                           readonly="1"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="patient_id" readonly="1"/>
                                    <field name="target_days" readonly="1"/>
                                    <field name="daily_units"/>
                                    <field name="required_units" readonly="1"/>
                                    <field name="allocated_packs" readonly="1"/>
                                    <field name="supplied_units" readonly="1"/>
                                    <field name="excess_units" readonly="1"/>
                                    <field name="coverage_days" readonly="1"/>
                                    <field name="allocation_status" widget="badge" readonly="1"/>
                                    <field name="requested_packs" optional="hide" readonly="1"/>
                                    <field name="calculated_packs" optional="hide" readonly="1"/>
                                    <field name="original_daily_units" optional="hide" readonly="1"/>
                                    <field name="daily_units_changed_by" optional="hide" readonly="1"/>
                                    <field name="daily_units_changed_at" optional="hide" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <group string="Totals">
                        <field name="required_units" readonly="1"/>
                        <field name="available_packs" readonly="1"/>
                        <field name="allocated_packs" readonly="1"/>
                        <field name="supplied_units" readonly="1"/>
                        <field name="excess_units" readonly="1"/>
                        <field name="distribution_stale" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_allocate_or_reallocate"
                            string="Allocate or Reallocate"
                            type="object"
                            class="btn-primary"
                            data-hotkey="a"/>
                    <button string="Discard"
                            special="cancel"
                            class="btn-secondary"
                            data-hotkey="d"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
