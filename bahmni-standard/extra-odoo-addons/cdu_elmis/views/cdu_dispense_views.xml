<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cdu_prescription_form_dispensing_button" model="ir.ui.view">
        <field name="name">cdu.prescription.form.dispensing.button</field>
        <field name="model">cdu.prescription</field>
        <field name="inherit_id" ref="cdu_prescription.view_cdu_prescription_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_remap_regimens']" position="before">
                <button name="action_open_dispensing"
                        string="Start Dispensing"
                        type="object"
                        class="oe_highlight"
                        groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"
                        attrs="{'invisible': [('state', '!=', 'awaiting_dispensing')]}"/>
                <button name="action_reprint_dispensing_labels"
                        string="Reprint Labels"
                        type="object"
                        class="btn-secondary"
                        groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"
                        attrs="{'invisible': [('state', 'not in', ('awaiting_bagging_qa', 'awaiting_boxing', 'awaiting_dispatch', 'dispatched'))]}"/>
            </xpath>
        </field>
    </record>

    <record id="view_cdu_dispense_tree" model="ir.ui.view">
        <field name="name">cdu.dispense.tree</field>
        <field name="model">cdu.dispense</field>
        <field name="arch" type="xml">
            <tree class="o_cdu_production_list"
                  default_order="next_drug_pickup_date asc, patient_name asc"
                  decoration-success="state == 'confirmed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="patient_name"/>
                <field name="patient_identifier"/>
                <field name="regimen_prescribed_raw"/>
                <field name="next_drug_pickup_date"/>
                <field name="batch_id"/>
                <field name="production_stock_refreshed_at"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_cdu_dispense_form" model="ir.ui.view">
        <field name="name">cdu.dispense.form</field>
        <field name="model">cdu.dispense</field>
        <field name="arch" type="xml">
            <form class="o_cdu_prescription_form o_cdu_batch_form o_cdu_stage_dispensing">
                <header>
                    <button name="action_confirm_dispensing"
                            string="Confirm Dispensing"
                            type="object"
                            class="btn-primary"
                            groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"
                            confirm="Confirm dispensing for this prescription?&#10;&#10;Before continuing, make sure the eLMIS product, batch number, dispensed packs, and dosing instructions are correct.&#10;&#10;This moves the prescription to Awaiting Bagging / QA and generates the dispensing slip, medicine label, and bag label. eLMIS stock is not consumed at this step; consumption happens when the box is confirmed."
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_reject_to_call_center"
                            string="Reject to Call Center"
                            type="object"
                            class="btn-danger"
                            groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_reject_to_facility"
                            string="Reject to Facility"
                            type="object"
                            class="btn-danger"
                            groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_cancel_dispensing"
                            string="Cancel Dispensing"
                            type="object"
                            class="btn-secondary o_cdu_cancel_dispensing_button"
                            groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"
                            confirm="Cancel this dispensing job?&#10;&#10;The prescription will stay in the dispensing work queue and can be started again."
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_print_labels"
                            string="Reprint Labels"
                            type="object"
                            class="btn-primary"
                            groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"
                            attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                    <button name="action_mark_labels_printed"
                            string="Mark Labels Printed"
                            type="object"
                            class="btn-secondary"
                            groups="cdu_prescription.group_cdu_dispensing_officer,cdu_prescription.group_cdu_admin"
                            attrs="{'invisible': ['|', ('state', '!=', 'confirmed'), ('labels_printed', '=', True)]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title o_cdu_workspace_hero">
                        <span class="o_cdu_workspace_eyebrow">Dispensing workspace</span>
                        <h1><field name="name"/></h1>
                        <p class="o_cdu_workspace_subtitle">
                            Confirm stock, quantities, dosing instructions, and labels for this prescription.
                        </p>
                    </div>

                    <div class="o_cdu_batch_dashboard">
                        <div class="o_cdu_batch_card">
                            <h3>Patient</h3>
                            <div class="o_cdu_batch_card_fields">
                                <label for="patient_name"/>
                                <field name="patient_name" nolabel="1" readonly="1"/>
                                <label for="patient_phone"/>
                                <field name="patient_phone" nolabel="1" readonly="1"/>
                                <label for="collection_point_id"/>
                                <field name="collection_point_id" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                        <div class="o_cdu_batch_card">
                            <h3>Prescription</h3>
                            <div class="o_cdu_batch_card_fields">
                                <label for="prescription_id"/>
                                <field name="prescription_id" nolabel="1" readonly="1"/>
                                <label for="regimen_prescribed_raw"/>
                                <field name="regimen_prescribed_raw" nolabel="1" readonly="1"/>
                                <label for="next_drug_pickup_date"/>
                                <field name="next_drug_pickup_date" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                        <div class="o_cdu_batch_card">
                            <h3>Dispensing</h3>
                            <div class="o_cdu_batch_card_fields">
                                <label for="batch_id"/>
                                <field name="batch_id" nolabel="1" readonly="1"/>
                                <label for="production_stock_refreshed_at"/>
                                <field name="production_stock_refreshed_at" nolabel="1" readonly="1"/>
                                <label for="dispensing_ready"/>
                                <field name="dispensing_ready" nolabel="1" readonly="1"/>
                                <label for="cancelled_at" attrs="{'invisible': [('state', '!=', 'cancelled')]}"/>
                                <field name="cancelled_at" nolabel="1" readonly="1" attrs="{'invisible': [('state', '!=', 'cancelled')]}"/>
                                <label for="cancelled_by" attrs="{'invisible': [('state', '!=', 'cancelled')]}"/>
                                <field name="cancelled_by" nolabel="1" readonly="1" attrs="{'invisible': [('state', '!=', 'cancelled')]}"/>
                            </div>
                        </div>
                        <div class="o_cdu_batch_card">
                            <h3>Labels</h3>
                            <div class="o_cdu_batch_card_fields">
                                <label for="labels_printed"/>
                                <field name="labels_printed" nolabel="1" readonly="1"/>
                                <label for="labels_printed_by"/>
                                <field name="labels_printed_by" nolabel="1" readonly="1"/>
                                <label for="labels_printed_at"/>
                                <field name="labels_printed_at" nolabel="1" readonly="1"/>
                            </div>
                        </div>
                    </div>

                    <div class="o_cdu_batch_readiness_message" attrs="{'invisible': [('dispensing_ready', '=', True)]}">
                        <field name="dispensing_readiness_message" readonly="1" nolabel="1"/>
                    </div>

                    <notebook class="o_cdu_workspace_notebook">
                        <page string="Regimen">
                            <div class="alert alert-info o_cdu_elmis_fulfilment_hint" role="alert">
                                Products are prefilled from the patient prescription and batch picking lines. Add or remove products as needed, then confirm the exact product, batch, quantity, and dosing instructions.
                            </div>
                            <div class="o_cdu_elmis_section_title">Regimen Products</div>
                            <field name="stock_selection_ids"
                                   string="Regimen Products"
                                   class="o_cdu_regimen_product_list"
                                   attrs="{'readonly': [('state', '!=', 'draft')]}">
                                <tree editable="bottom">
                                    <control>
                                        <create string="Add Product"/>
                                    </control>
                                    <field name="dispense_id" invisible="1"/>
                                    <field name="stock_option_id"
                                           string="Product"
                                           class="o_cdu_regimen_product_column"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <field name="dosage_instructions"
                                           string="Dosage / Instructions"
                                           class="o_cdu_regimen_dosage_column"/>
                                    <field name="openmrs_drug_name"
                                           string="Prescribed Product / Regimen"
                                           optional="hide"/>
                                    <field name="selected_orderable_name" readonly="1" optional="hide"/>
                                    <field name="selected_pack_size" string="Pack Size" readonly="1" optional="hide"/>
                                    <field name="selected_lot" readonly="1" optional="hide"/>
                                    <field name="selected_lot_expiry" readonly="1" optional="hide"/>
                                    <field name="selected_stock_on_hand" string="Available Packs" readonly="1" optional="hide"/>
                                    <field name="quantity_dispensed"
                                           string="Dispensed Packs"
                                           widget="cdu_no_trailing_zeros_float"
                                           optional="hide"/>
                                    <field name="dispensed_units"
                                           string="Dispensed Units"
                                           widget="cdu_no_trailing_zeros_float"
                                           readonly="1"/>
                                    <field name="selected_orderable_code" optional="hide"/>
                                    <field name="selected_orderable_id" optional="hide"/>
                                    <field name="selected_lot_id" optional="hide"/>
                                    <field name="picking_fulfilment_line_id" optional="hide"/>
                                </tree>
                            </field>
                            <group class="o_cdu_regimen_schedule">
                                <field name="duration_days" readonly="1"/>
                                <field name="next_drug_pickup_date"
                                       string="Next Refill Date"
                                       readonly="1"/>
                            </group>
                            <group string="Partial Dispense / Backorder">
                                <field name="backorder_reason"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="backorder_notes"
                                       placeholder="Required context when Other is selected"
                                       attrs="{'readonly': [('state', '!=', 'draft')]}"/>
                                <field name="created_backorder_id"
                                       readonly="1"
                                       attrs="{'invisible': [('created_backorder_id', '=', False)]}"/>
                                <div class="alert alert-warning" role="alert"
                                     attrs="{'invisible': [('state', '!=', 'draft')]}">
                                    If any dispensed quantity is lower than the picked requirement, select a shortage reason. Confirmation will create a backorder in Awaiting Verification for the outstanding quantity.
                                </div>
                            </group>
                        </page>
                        <page string="Available CDU Production Floor Stock">
                            <div class="alert alert-info o_cdu_elmis_empty_stock_hint"
                                 role="alert"
                                 attrs="{'invisible': [('stock_option_ids', '!=', [])]}">
                                No Production Floor stock has been loaded for this prescription yet. Reload the page to retry the automatic refresh, or confirm your eLMIS session is active.
                            </div>
                            <div class="alert alert-info o_cdu_elmis_stock_hint" role="alert">
                                Review the product summary first, then open Batches/Lots for expiry and batch detail. Red rows are expired, amber rows need attention, and grey rows have no expiry date.
                            </div>
                            <div class="o_cdu_elmis_section_title">Product Summary</div>
                            <field name="stock_summary_ids" readonly="1">
                                <tree create="0" delete="0"
                                      default_order="orderable_name asc"
                                      decoration-danger="stock_status == 'expired'"
                                      decoration-warning="stock_status in ('expires_soon', 'low_stock')"
                                      decoration-muted="stock_status == 'no_expiry'">
                                    <field name="orderable_name" string="Product"/>
                                    <field name="stock_status" string="Status" widget="badge"
                                           decoration-danger="stock_status == 'expired'"
                                           decoration-warning="stock_status in ('expires_soon', 'low_stock')"
                                           decoration-muted="stock_status == 'no_expiry'"/>
                                    <field name="lot_count"/>
                                    <field name="total_stock_on_hand" sum="Total Packs"/>
                                    <field name="total_stock_on_hand_units" sum="Total Units"/>
                                    <field name="earliest_expiration_date"/>
                                    <field name="latest_stock_date"/>
                                    <button name="action_open_lot_details"
                                            type="object"
                                            string="Batches/Lots"
                                            icon="fa-list-ul"/>
                                    <field name="orderable_code" optional="hide"/>
                                    <field name="orderable_id" optional="hide"/>
                                </tree>
                                <form string="Product Stock Summary">
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="orderable_name"/>
                                                <field name="stock_status" widget="badge"/>
                                                <field name="lot_count"/>
                                            </group>
                                            <group>
                                                <field name="total_stock_on_hand"/>
                                                <field name="total_stock_on_hand_units"/>
                                                <field name="earliest_expiration_date"/>
                                                <field name="latest_stock_date"/>
                                            </group>
                                        </group>
                                        <group string="Batches/Lots">
                                            <field name="detail_option_ids" readonly="1">
                                                <tree create="0" delete="0"
                                                      default_order="expiration_date asc, lot asc"
                                                      decoration-danger="stock_status == 'expired'"
                                                      decoration-warning="stock_status in ('expires_soon', 'low_stock')"
                                                      decoration-muted="stock_status == 'no_expiry'">
                                                    <field name="stock_status" string="Status" widget="badge"
                                                           decoration-danger="stock_status == 'expired'"
                                                           decoration-warning="stock_status in ('expires_soon', 'low_stock')"
                                                           decoration-muted="stock_status == 'no_expiry'"/>
                                                    <field name="lot" string="Batch Number"/>
                                                    <field name="expiration_date" string="Expiry Date"/>
                                                    <field name="pack_size"/>
                                                    <field name="stock_on_hand" string="Available Packs"/>
                                                    <field name="stock_on_hand_units" string="Available Units"/>
                                                    <field name="occurred_date" string="Stock Date"/>
                                                </tree>
                                            </field>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                            <div class="o_cdu_elmis_section_title">Batch/Lot Details</div>
                            <field name="stock_option_ids" readonly="1">
                                <tree create="0" delete="0"
                                      default_order="orderable_name asc, expiration_date asc, lot asc"
                                      decoration-danger="stock_status == 'expired'"
                                      decoration-warning="stock_status in ('expires_soon', 'low_stock')"
                                      decoration-muted="stock_status == 'no_expiry'">
                                    <field name="orderable_name" string="Product"/>
                                    <field name="stock_status" string="Status" widget="badge"
                                           decoration-danger="stock_status == 'expired'"
                                           decoration-warning="stock_status in ('expires_soon', 'low_stock')"
                                           decoration-muted="stock_status == 'no_expiry'"/>
                                    <field name="lot" string="Batch Number"/>
                                    <field name="expiration_date" string="Expiry Date"/>
                                    <field name="pack_size"/>
                                    <field name="stock_on_hand" string="Available Packs" sum="Total Packs"/>
                                    <field name="stock_on_hand_units" string="Available Units" optional="show" sum="Total Units"/>
                                    <field name="expires_in_days" optional="hide"/>
                                    <field name="occurred_date" string="Stock Date"/>
                                    <field name="orderable_code" optional="hide"/>
                                    <field name="orderable_id" optional="hide"/>
                                    <field name="lot_id" optional="hide"/>
                                    <field name="facility_code" optional="hide"/>
                                    <field name="program_code" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_cdu_dispense_search" model="ir.ui.view">
        <field name="name">cdu.dispense.search</field>
        <field name="model">cdu.dispense</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_name"/>
                <field name="patient_identifier"/>
                <field name="regimen_prescribed_raw"/>
                <field name="batch_id"/>
                <filter string="Created Today"
                        name="created_today"
                        domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Pickup Within 7 Days"
                        name="pickup_next_seven_days"
                        domain="[('next_drug_pickup_date', '&gt;=', context_today()), ('next_drug_pickup_date', '&lt;=', context_today() + relativedelta(days=7))]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Batch" name="group_batch" context="{'group_by': 'batch_id'}"/>
                    <filter string="Pickup Date" name="group_pickup_date" context="{'group_by': 'next_drug_pickup_date'}"/>
                    <filter string="Created Day" name="group_created_day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cdu_dispense" model="ir.actions.act_window">
        <field name="name">Dispensing Records</field>
        <field name="res_model">cdu.dispense</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_cdu_dispense_search"/>
    </record>

    <record id="action_cdu_dispensing_work_queue" model="ir.actions.act_window">
        <field name="name">Dispensing Work Queue</field>
        <field name="res_model">cdu.prescription</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="cdu_prescription.view_cdu_prescription_search"/>
        <field name="domain">[('state', '=', 'awaiting_dispensing')]</field>
        <field name="context">{'search_default_group_batch': 1, 'search_default_group_collection_point': 1}</field>
    </record>

    <record id="action_cdu_awaiting_bagging_qa" model="ir.actions.act_window">
        <field name="name">Awaiting Bagging / QA</field>
        <field name="res_model">cdu.prescription</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="cdu_prescription.view_cdu_prescription_search"/>
        <field name="domain">[('state', '=', 'awaiting_bagging_qa')]</field>
        <field name="context">{'search_default_group_batch': 1}</field>
    </record>
</odoo>
