<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cdu_label_print_wizard_form" model="ir.ui.view">
        <field name="name">cdu.label.print.wizard.form</field>
        <field name="model">cdu.label.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Preview / Print Labels">
                <sheet>
                    <group>
                        <group string="Print Layout">
                            <field name="label_layout" widget="radio"/>
                            <field name="dispensing_slip_count" readonly="1"/>
                            <field name="medicine_label_count" readonly="1"/>
                            <field name="bag_label_count" readonly="1"/>
                            <field name="total_label_count" readonly="1"/>
                        </group>
                        <group string="Patient">
                            <field name="patient_name" readonly="1"/>
                            <field name="patient_identifier" readonly="1"/>
                            <field name="patient_phone" readonly="1"/>
                            <field name="prescription_id" readonly="1"/>
                            <field name="collection_point_id" readonly="1"/>
                            <field name="next_drug_pickup_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dispensing Slip Preview">
                            <group>
                                <field name="dispense_id" readonly="1"/>
                                <field name="patient_name" readonly="1"/>
                                <field name="patient_identifier" readonly="1"/>
                                <field name="patient_phone" readonly="1"/>
                                <field name="prescription_id" readonly="1"/>
                                <field name="collection_point_id" readonly="1"/>
                                <field name="next_drug_pickup_date" readonly="1"/>
                            </group>
                        </page>
                        <page string="Medicine Labels Preview">
                            <field name="stock_selection_ids" readonly="1">
                                <tree create="0" edit="0" delete="0">
                                    <field name="openmrs_drug_name"/>
                                    <field name="selected_orderable_name"/>
                                    <field name="selected_lot"/>
                                    <field name="selected_lot_expiry"/>
                                    <field name="quantity_dispensed"/>
                                    <field name="dosage_instructions"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Bag Label Preview">
                            <group>
                                <field name="dispense_id" readonly="1"/>
                                <field name="patient_name" readonly="1"/>
                                <field name="patient_identifier" readonly="1"/>
                                <field name="patient_phone" readonly="1"/>
                                <field name="collection_point_id" readonly="1"/>
                                <field name="next_drug_pickup_date" readonly="1"/>
                                <field name="total_label_count" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_print_labels"
                            string="Print Labels"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
