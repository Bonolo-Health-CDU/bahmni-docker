<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="ir_cron_cdu_collect_go_message_poll" model="ir.cron">
        <field name="name">CDU Collect-and-Go Message Poll</field>
        <field name="model_id" ref="model_cdu_box"/>
        <field name="state">code</field>
        <field name="code">model.cron_poll_collect_go_message_status()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_cdu_collect_go_status_poll" model="ir.cron">
        <field name="name">CDU Collect-and-Go Status Poll</field>
        <field name="model_id" ref="model_cdu_box"/>
        <field name="state">code</field>
        <field name="code">model.cron_poll_collect_go_parcel_status()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
