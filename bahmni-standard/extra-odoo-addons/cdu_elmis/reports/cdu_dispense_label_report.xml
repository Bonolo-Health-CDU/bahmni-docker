<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="paperformat_cdu_dispense_labels" model="report.paperformat">
        <field name="name">CDU Dispensing Labels 4x6</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">102</field>
        <field name="page_height">152</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">3</field>
        <field name="margin_left">3</field>
        <field name="margin_right">3</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">203</field>
    </record>

    <record id="action_report_cdu_dispense_labels" model="ir.actions.report">
        <field name="name">CDU Dispensing Slip, Medicine and Bag Labels</field>
        <field name="model">cdu.dispense</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cdu_elmis.report_cdu_dispense_labels</field>
        <field name="report_file">cdu_elmis.report_cdu_dispense_labels</field>
        <field name="paperformat_id" ref="cdu_elmis.paperformat_cdu_dispense_labels"/>
        <field name="print_report_name">'CDU Dispensing Labels - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_cdu_dispense"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('cdu_prescription.group_cdu_dispensing_officer')), (4, ref('cdu_prescription.group_cdu_admin'))]"/>
    </record>

    <template id="report_cdu_dispense_labels">
        <t t-foreach="docs" t-as="dispense">
            <t t-set="full_width" t-value="True"/>
            <t t-call="web.basic_layout">
                    <t t-set="label_layout" t-value="dispense.env.context.get('cdu_label_layout', 'all')"/>
                    <t t-set="prescription" t-value="dispense.prescription_id"/>
                    <t t-set="script_number" t-value="prescription.name or dispense.name"/>
                    <t t-set="facility_name" t-value="prescription.facility_name or dispense.env.company.name"/>
                    <t t-set="pickup_point" t-value="dispense.collection_point_id.name or prescription.drug_pickup_point_raw or ''"/>
                    <style>
                        .cdu-print-page {
                            font-family: Arial, sans-serif;
                            font-size: 12px;
                            line-height: 1.22;
                            page-break-after: always;
                        }
                        .cdu-print-sheet {
                            box-sizing: border-box;
                            min-height: 136mm;
                            padding: 5mm;
                        }
                        .cdu-slip {
                            font-size: 11px;
                        }
                        .cdu-slip-header {
                            text-align: center;
                            margin-bottom: 6mm;
                        }
                        .cdu-org {
                            font-size: 18px;
                            font-weight: 700;
                            letter-spacing: 0;
                            text-transform: uppercase;
                        }
                        .cdu-muted {
                            color: #333;
                        }
                        .cdu-small {
                            font-size: 10px;
                        }
                        .cdu-rule {
                            border-top: 1px solid #111;
                            margin: 4mm 0;
                        }
                        .cdu-title {
                            font-size: 13px;
                            font-weight: 700;
                            text-align: center;
                            text-decoration: underline;
                            text-transform: uppercase;
                            margin: 2mm 0 3mm;
                        }
                        .cdu-row {
                            display: table;
                            width: 100%;
                            margin-bottom: 2mm;
                        }
                        .cdu-row > div {
                            display: table-cell;
                            vertical-align: top;
                        }
                        .cdu-label-key {
                            width: 30%;
                            font-weight: 700;
                        }
                        .cdu-table {
                            border-collapse: collapse;
                            width: 100%;
                            margin: 3mm 0;
                        }
                        .cdu-table th,
                        .cdu-table td {
                            border: 1px solid #555;
                            padding: 2mm;
                            text-align: left;
                            vertical-align: top;
                        }
                        .cdu-table th {
                            background: #e6e6e6;
                            font-weight: 700;
                        }
                        .cdu-medicine-label {
                            color: #102f45;
                            font-size: 20px;
                            font-weight: 400;
                            line-height: 1.2;
                            padding: 4mm;
                            -webkit-print-color-adjust: exact;
                        }
                        .cdu-medicine-card {
                            border: 1mm solid #086da3;
                            border-radius: 8mm;
                            box-sizing: border-box;
                            height: 348mm;
                            overflow: hidden;
                            page-break-inside: avoid;
                            position: relative;
                        }
                        .cdu-medicine-brand {
                            border-bottom: 0.8mm solid #087f7b;
                            box-sizing: border-box;
                            display: table;
                            padding: 6mm 7mm 5mm;
                            width: 100%;
                        }
                        .cdu-medicine-brand > div {
                            display: table-cell;
                            vertical-align: middle;
                        }
                        .cdu-medicine-logo-cell {
                            width: 30mm;
                        }
                        .cdu-medicine-logo {
                            display: block;
                            height: 26mm;
                            width: auto;
                        }
                        .cdu-medicine-brand-copy {
                            padding-left: 5mm;
                        }
                        .cdu-medicine-brand-name {
                            color: #086da3;
                            font-size: 30px;
                            font-weight: 700;
                            line-height: 1.05;
                            text-transform: uppercase;
                        }
                        .cdu-medicine-brand-unit {
                            color: #087f7b;
                            font-size: 16px;
                            font-weight: 700;
                            letter-spacing: 1.2px;
                            margin-top: 2mm;
                            text-transform: uppercase;
                        }
                        .cdu-medicine-qr-cell {
                            text-align: right;
                            width: 32mm;
                        }
                        .cdu-medicine-qr {
                            display: inline-block;
                            height: 30mm;
                            width: 30mm;
                        }
                        .cdu-safety {
                            background: #eaf5f7;
                            border-bottom: 0.6mm solid #087f7b;
                            color: #102f45;
                            font-size: 18px;
                            font-weight: 700;
                            letter-spacing: 0.6px;
                            padding: 3.4mm 7mm;
                            text-align: center;
                            text-transform: uppercase;
                        }
                        .cdu-medicine-body {
                            padding: 6mm 8mm 32mm;
                        }
                        .cdu-field-caption {
                            color: #087f7b;
                            font-size: 14px;
                            font-weight: 700;
                            letter-spacing: 1.2px;
                            margin-bottom: 1.6mm;
                            text-transform: uppercase;
                        }
                        .cdu-drug {
                            color: #071d2d;
                            font-size: 34px;
                            font-weight: 700;
                            line-height: 1.12;
                            margin: 0 0 6mm;
                            text-transform: uppercase;
                        }
                        .cdu-directions {
                            background: #eef6fb;
                            border-left: 2.4mm solid #086da3;
                            border-radius: 3mm;
                            color: #071d2d;
                            font-size: 30px;
                            font-weight: 700;
                            line-height: 1.18;
                            margin: 0 0 6mm;
                            min-height: 26mm;
                            padding: 5mm 6mm;
                        }
                        .cdu-medicine-patient-row {
                            display: table;
                            width: 100%;
                        }
                        .cdu-medicine-patient-row > div {
                            display: table-cell;
                            vertical-align: bottom;
                        }
                        .cdu-medicine-patient {
                            color: #071d2d;
                            font-size: 28px;
                            font-weight: 700;
                            line-height: 1.15;
                        }
                        .cdu-medicine-date {
                            font-size: 18px;
                            text-align: right;
                            white-space: nowrap;
                            width: 60mm;
                        }
                        .cdu-medicine-rule {
                            border-top: 0.6mm solid #7b8d98;
                            margin: 4mm 0;
                        }
                        .cdu-script-repeat {
                            display: table;
                            width: 100%;
                        }
                        .cdu-script-repeat > div {
                            display: table-cell;
                            font-size: 20px;
                            font-weight: 700;
                            vertical-align: top;
                        }
                        .cdu-script-repeat > div:last-child {
                            text-align: right;
                        }
                        .cdu-medicine-meta {
                            display: table;
                            font-size: 16px;
                            margin-top: 4mm;
                            width: 100%;
                        }
                        .cdu-medicine-meta > div {
                            display: table-cell;
                            vertical-align: top;
                            width: 50%;
                        }
                        .cdu-medicine-meta > div:last-child {
                            padding-left: 6mm;
                        }
                        .cdu-medicine-meta-row {
                            margin-bottom: 2mm;
                        }
                        .cdu-medicine-meta-key {
                            font-weight: 700;
                        }
                        .cdu-medicine-footer {
                            background: #086da3;
                            bottom: 0;
                            box-sizing: border-box;
                            color: #fff;
                            display: table;
                            font-size: 16px;
                            left: 0;
                            padding: 4mm 7mm;
                            position: absolute;
                            width: 100%;
                        }
                        .cdu-medicine-footer > div {
                            display: table-cell;
                            vertical-align: middle;
                        }
                        .cdu-medicine-footer > div:last-child {
                            font-weight: 700;
                            text-align: right;
                            text-transform: uppercase;
                        }
                        .cdu-bag-label {
                            font-size: 17px;
                            font-weight: 700;
                        }
                        .cdu-bag-label .cdu-script {
                            font-size: 21px;
                            margin-bottom: 2mm;
                        }
                        .cdu-bag-grid {
                            display: table;
                            width: 100%;
                        }
                        .cdu-bag-main,
                        .cdu-bag-dates {
                            display: table-cell;
                            vertical-align: top;
                        }
                        .cdu-bag-main {
                            width: 68%;
                        }
                        .cdu-bag-dates {
                            width: 32%;
                            font-size: 13px;
                            padding-left: 5mm;
                        }
                        .cdu-code-grid {
                            display: table;
                            width: 100%;
                        }
                        .cdu-code-barcode,
                        .cdu-code-qr {
                            display: table-cell;
                            vertical-align: top;
                        }
                        .cdu-code-barcode {
                            width: 64%;
                        }
                        .cdu-code-qr {
                            width: 36%;
                            text-align: center;
                        }
                        .cdu-barcode {
                            display: block;
                            width: 40mm;
                            height: 14mm;
                            margin: 1mm 0 2mm;
                            background: #fff;
                        }
                        .cdu-barcode-caption {
                            font-size: 14px;
                            text-align: center;
                            width: 40mm;
                            margin-bottom: 8mm;
                        }
                        .cdu-qr {
                            display: block;
                            width: 20mm;
                            height: 20mm;
                            margin: 0 auto 1mm;
                            background: #fff;
                        }
                        .cdu-qr-caption {
                            font-size: 9px;
                            line-height: 1.1;
                            text-align: center;
                        }
                        .cdu-bag-section {
                            margin-top: 5mm;
                        }
                    </style>

                    <div t-if="label_layout in ('all', 'slip')" class="page cdu-print-page">
                        <div class="cdu-print-sheet cdu-slip">
                            <div class="cdu-slip-header">
                                <div class="cdu-org"><span t-esc="facility_name"/></div>
                                <div class="cdu-muted" t-if="prescription.facility_code">
                                    <span t-field="prescription.facility_code"/>
                                </div>
                                <div class="cdu-muted" t-if="pickup_point">
                                    Collect at <span t-esc="pickup_point"/>
                                </div>
                            </div>
                            <div>
                                <strong><span t-field="dispense.patient_name"/></strong>
                                <span t-if="dispense.patient_identifier">
                                    (<span t-field="dispense.patient_identifier"/>)
                                </span>
                            </div>
                            <div t-if="dispense.patient_phone" style="margin-top: 16mm;">
                                <span t-field="dispense.patient_phone"/>
                            </div>
                            <div class="cdu-rule"/>
                            <div>
                                <strong>Your next collection date is:</strong>
                                <span t-field="dispense.next_drug_pickup_date"/>
                            </div>
                            <div t-if="pickup_point">
                                <strong>Please collect at:</strong>
                                <span t-esc="pickup_point"/>
                            </div>
                            <div class="cdu-rule"/>
                            <div class="cdu-title">Dispensing Receipt</div>
                            <div class="cdu-row">
                                <div class="cdu-label-key">Prescription:</div>
                                <div><span t-esc="script_number"/></div>
                            </div>
                            <div class="cdu-row" t-if="prescription.prescriber_name">
                                <div class="cdu-label-key">Prescriber:</div>
                                <div><span t-field="prescription.prescriber_name"/></div>
                            </div>
                            <table class="cdu-table">
                                <thead>
                                    <tr>
                                        <th>Item</th>
                                        <th>Qty</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="dispense.stock_selection_ids" t-as="line">
                                        <td>
                                            <span t-esc="line.selected_orderable_name or line.openmrs_drug_name"/>
                                        </td>
                                        <td><span t-field="line.quantity_dispensed"/></td>
                                        <td>Dispensed</td>
                                    </tr>
                                    <tr t-if="not dispense.stock_selection_ids">
                                        <td colspan="3">No dispense stock selections were captured.</td>
                                    </tr>
                                </tbody>
                            </table>
                            <div>
                                <strong>Pharmacist:</strong>
                                <span t-field="dispense.confirmed_by"/>
                            </div>
                            <div style="margin-top: 4mm;">
                                <strong>This is Repeat</strong>
                                <span>1</span>
                            </div>
                            <div class="cdu-small" style="text-align: center; margin-top: 8mm;">
                                If medication was not dispensed it is not available from the automatic dispensing unit and must be collected at the pharmacist's counter.
                            </div>
                        </div>
                    </div>

                    <t t-if="label_layout in ('all', 'medicine') and dispense.stock_selection_ids">
                        <t t-foreach="dispense.stock_selection_ids" t-as="line">
                            <t t-foreach="range(int(line.quantity_dispensed or 0))" t-as="label_copy">
                                <div class="page cdu-print-page">
                                    <div class="cdu-print-sheet cdu-medicine-label">
                                        <div class="cdu-medicine-card">
                                            <div class="cdu-medicine-brand">
                                                <div class="cdu-medicine-logo-cell">
                                                    <img class="cdu-medicine-logo"
                                                         src="/cdu_elmis/static/src/img/moh_lesotho_logo.png"
                                                         alt="Ministry of Health Lesotho"/>
                                                </div>
                                                <div class="cdu-medicine-brand-copy">
                                                    <div class="cdu-medicine-brand-name">Bonolo Health</div>
                                                    <div class="cdu-medicine-brand-unit">Central Dispensing Unit</div>
                                                </div>
                                                <div class="cdu-medicine-qr-cell">
                                                    <img class="cdu-medicine-qr"
                                                         t-att-src="dispense.get_barcode_data_uri(dispense.get_label_qr_value(), 'QR', 180, 180)"
                                                         t-att-alt="'QR code for %s' % script_number"/>
                                                </div>
                                            </div>
                                            <div class="cdu-safety">Keep out of reach of children</div>
                                            <div class="cdu-medicine-body">
                                                <div class="cdu-field-caption">Medicine</div>
                                                <div class="cdu-drug">
                                                    <span t-esc="line.selected_orderable_name or line.openmrs_drug_name"/>
                                                </div>
                                                <div class="cdu-field-caption">Directions</div>
                                                <div class="cdu-directions">
                                                    <span t-field="line.dosage_instructions"/>
                                                </div>
                                                <div class="cdu-medicine-patient-row">
                                                    <div>
                                                        <div class="cdu-field-caption">Patient</div>
                                                        <div class="cdu-medicine-patient">
                                                            <span t-field="dispense.patient_name"/>
                                                            <span t-if="dispense.patient_identifier">
                                                                (<span t-field="dispense.patient_identifier"/>)
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div class="cdu-medicine-date">
                                                        <div class="cdu-field-caption">Dispensed</div>
                                                        <span t-if="dispense.labels_printed_at"
                                                              t-field="dispense.labels_printed_at"
                                                              t-options='{"widget": "datetime", "format": "dd/MM/yyyy HH:mm"}'/>
                                                        <span t-if="not dispense.labels_printed_at and dispense.confirmed_at"
                                                              t-field="dispense.confirmed_at"
                                                              t-options='{"widget": "datetime", "format": "dd/MM/yyyy HH:mm"}'/>
                                                    </div>
                                                </div>
                                                <div class="cdu-medicine-rule"/>
                                                <div class="cdu-script-repeat">
                                                    <div>
                                                        <div class="cdu-field-caption">Prescription</div>
                                                        <span t-esc="script_number"/>
                                                    </div>
                                                    <div>
                                                        <div class="cdu-field-caption">Supply</div>
                                                        Bottle <span t-esc="label_copy + 1"/> of <span t-esc="int(line.quantity_dispensed or 0)"/>
                                                        &#183; Repeat 1
                                                    </div>
                                                </div>
                                                <div class="cdu-medicine-meta">
                                                    <div>
                                                        <div class="cdu-medicine-meta-row" t-if="line.selected_lot">
                                                            <span class="cdu-medicine-meta-key">Batch:</span>
                                                            <span t-field="line.selected_lot"/>
                                                        </div>
                                                        <div class="cdu-medicine-meta-row" t-if="line.selected_lot_expiry">
                                                            <span class="cdu-medicine-meta-key">Expiry:</span>
                                                            <span t-field="line.selected_lot_expiry"
                                                                  t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/>
                                                        </div>
                                                    </div>
                                                    <div>
                                                        <div class="cdu-medicine-meta-row" t-if="line.selected_pack_size">
                                                            <span class="cdu-medicine-meta-key">Pack size:</span>
                                                            <span t-field="line.selected_pack_size"/>
                                                        </div>
                                                        <div class="cdu-medicine-meta-row">
                                                            <span class="cdu-medicine-meta-key">Dispenser:</span>
                                                            <span t-field="dispense.labels_printed_by"/>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="cdu-medicine-footer">
                                                <div>
                                                    <span t-esc="facility_name"/>
                                                    <span t-if="prescription.facility_code">
                                                        &#183; <span t-field="prescription.facility_code"/>
                                                    </span>
                                                </div>
                                                <div>Bonolo Health CDU</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </t>
                    </t>
                    <div t-if="label_layout in ('all', 'medicine') and not dispense.stock_selection_ids" class="page cdu-print-page">
                        <div class="cdu-print-sheet cdu-medicine-label">
                            <div class="cdu-org">Medicine Label</div>
                            No dispense stock selections were captured.
                        </div>
                    </div>

                    <div t-if="label_layout in ('all', 'bag')" class="page cdu-print-page">
                        <div class="cdu-print-sheet cdu-bag-label">
                            <div class="cdu-bag-grid">
                                <div class="cdu-bag-main">
                                    <div class="cdu-script">
                                        Script Number:<span t-esc="script_number"/>
                                    </div>
                                    <div class="cdu-code-grid">
                                        <div class="cdu-code-barcode">
                                            <img class="cdu-barcode"
                                                 t-att-src="dispense.get_barcode_data_uri(script_number)"
                                                 t-att-alt="'Barcode for %s' % script_number"/>
                                            <div class="cdu-barcode-caption">
                                                <span t-esc="script_number"/>
                                            </div>
                                        </div>
                                        <div class="cdu-code-qr">
                                            <img class="cdu-qr"
                                                 t-att-src="dispense.get_barcode_data_uri(dispense.get_label_qr_value(), 'QR', 220, 220)"
                                                 t-att-alt="'QR code for %s' % script_number"/>
                                            <div class="cdu-qr-caption">Patient / Prescription</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="cdu-bag-dates">
                                    <div>
                                        Next Collection:<br/>
                                        <span t-field="dispense.next_drug_pickup_date"/>
                                    </div>
                                    <div style="margin-top: 6mm;">
                                        Collection Date:<br/>
                                        <span t-field="prescription.prescription_date"/>
                                    </div>
                                </div>
                            </div>
                            <div class="cdu-bag-section">
                                Pickup Point:<br/>
                                <span t-esc="pickup_point"/>
                            </div>
                            <div class="cdu-bag-section">
                                Patient:
                                <span t-field="dispense.patient_name"/>
                            </div>
                            <div class="cdu-bag-section">
                                Produced By:<span>Bonolo Health</span>
                            </div>
                        </div>
                    </div>
            </t>
        </t>
    </template>
</odoo>
